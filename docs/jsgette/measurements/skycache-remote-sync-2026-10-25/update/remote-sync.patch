+  private static Path cachedChunk(Path cache, Digest digest) throws IOException {
+    try (var paths = Files.walk(cache.resolve("leased-v2"))) {
+      List<Path> matches =
+          paths.filter(path -> path.getFileName().toString().equals(digest.getHash())).toList();
