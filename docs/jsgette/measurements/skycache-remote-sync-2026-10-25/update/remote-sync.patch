+  @Test
+  public void discoveryAndCommitResponsesMustMatchProtocolBounds() throws Exception {
+    try (Backend backend = new Backend();
+        SkyCacheTransport transport = backend.transport(Duration.ofSeconds(5))) {
+      transport.beginTransfer();
+      backend.discovery =
