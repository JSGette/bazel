+  private record Key(String name) implements KeyBytesProvider {
+    @Override
+    public byte[] toBytes() {
+      return name.getBytes(UTF_8);
+    }
+
+    @Override
+    public byte[] concat(byte[] suffix) {
+      return ByteBuffer.allocate(toBytes().length + suffix.length)
+          .put(toBytes())
+          .put(suffix)
+          .array();
+    }
+  }
