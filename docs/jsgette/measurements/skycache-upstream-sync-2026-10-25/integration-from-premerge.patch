-      help='The output file, mandatory.')
-  parser.add_argument(
-      '--file',
-      action='append',
-      help='A file to add to the layer')
-  parser.add_argument(
-      '--directory',
-      help='Directory in which to store the file inside the layer')
-  parser.add_argument(
