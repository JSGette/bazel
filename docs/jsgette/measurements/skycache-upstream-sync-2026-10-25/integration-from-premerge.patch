+  private static NodeInvalidationDataInfo transparentInfo(RoaringBitmap bitmap) {
+    return new NodeInvalidationDataInfo(
+        new PackedFingerprint(1L, 1L),
+        new SettableWriteStatus(),
+        bitmap,
+        /* hasOpaqueDependencies= */ false,
+        /* initialReferences= */ 0);
+  }
