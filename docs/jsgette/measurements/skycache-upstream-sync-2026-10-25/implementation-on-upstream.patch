+// Copyright 2026 The Bazel Authors. All rights reserved.
+// Licensed under the Apache License, Version 2.0. See the repository LICENSE.
+package com.google.devtools.build.lib.skyframe.serialization.local;
+
+import static com.google.common.util.concurrent.Futures.immediateFuture;
+import static java.util.concurrent.ForkJoinPool.commonPool;
+
+import com.google.common.collect.ImmutableList;
+import com.google.common.eventbus.Subscribe;
+import com.google.common.util.concurrent.ListenableFuture;
+import com.google.devtools.build.lib.analysis.AspectValue;
+import com.google.devtools.build.lib.analysis.BlazeDirectories;
+import com.google.devtools.build.lib.analysis.Runfiles;
+import com.google.devtools.build.lib.analysis.RunfilesOrigin;
+import com.google.devtools.build.lib.buildtool.buildevent.BuildCompleteEvent;
+import com.google.devtools.build.lib.concurrent.safeexecutor.SafeExecutor;
+import com.google.devtools.build.lib.concurrent.safeexecutor.SafeExecutorOwner;
+import com.google.devtools.build.lib.events.Event;
+import com.google.devtools.build.lib.remote.options.RemoteOptions;
+import com.google.devtools.build.lib.runtime.BlazeRuntime;
+import com.google.devtools.build.lib.runtime.CommandEnvironment;
+import com.google.devtools.build.lib.skyframe.RemoteConfiguredTargetValue;
+import com.google.devtools.build.lib.skyframe.serialization.FingerprintValueStore;
+import com.google.devtools.build.lib.skyframe.serialization.InMemoryFingerprintValueStore;
+import com.google.devtools.build.lib.skyframe.serialization.ObjectCodecRegistry;
+import com.google.devtools.build.lib.skyframe.serialization.SerializationModule;
+import com.google.devtools.build.lib.skyframe.serialization.SerializationRegistrySetupHelpers;
+import com.google.devtools.build.lib.skyframe.serialization.ValueSharingAdapter;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.ClientId;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCacheClient;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingOptions;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingServicesSupplier;
+import com.google.devtools.build.skyframe.SkyValue;
+import com.google.devtools.common.options.OptionPriority.PriorityCategory;
+import com.google.devtools.common.options.OptionsBase;
+import com.google.devtools.common.options.OptionsParser;
+import com.google.devtools.common.options.OptionsParsingException;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.function.Supplier;
+import javax.annotation.Nullable;
+
+/** Installs a concurrent local backend at the upstream analysis serialization/service boundary. */
+public final class LocalSkycacheModule extends SerializationModule {
+  private static final com.google.devtools.build.lib.skyframe.serialization.Fingerprinter
+      LOCAL_FINGERPRINTER =
+          com.google.devtools.build.lib.skyframe.serialization.FingerprintValueService
+              .NONPROD_FINGERPRINTER;
+
+  @Override
+  protected com.google.devtools.build.lib.skyframe.serialization.Fingerprinter
+      getFingerprinterForAnalysisCaching() {
+    return LOCAL_FINGERPRINTER;
+  }
+
+  private final Services services = new Services();
+  @Nullable private CommandEnvironment environment;
+  private boolean buildSucceeded;
+  @Nullable private Path retainedPublication;
+
+  @Override
+  protected Supplier<ObjectCodecRegistry> getAnalysisCodecRegistrySupplier(
+      BlazeRuntime runtime, BlazeDirectories directories) {
+    var fallback = super.getAnalysisCodecRegistrySupplier(runtime, directories);
+    return () -> {
+      if (services.session == null) {
+        return fallback.get();
+      }
+      return SerializationRegistrySetupHelpers.initializeAnalysisCodecRegistryBuilder(
+              runtime.getRuleClassProvider(),
+              SerializationRegistrySetupHelpers.makeReferenceConstants(
+                  directories,
+                  runtime.getRuleClassProvider(),
+                  runtime.getRuleClassProvider().getRunfilesPrefix()))
+          .add(new LocalPathCodec(directories.getWorkspace(), directories.getOutputBase()))
+          .add(new ValueSharingAdapter<>(new LocalSourceArtifactCodec()))
+          .addReferenceConstant(Runfiles.EMPTY)
+          .add(new ValueSharingAdapter<>(new LocalRunfilesCodec()))
+          .add(new ValueSharingAdapter<>(new LocalRepositoryMappingCodec()))
+          .add(new ValueSharingAdapter<>(new LocalSymlinkEntryCodec()))
+          .add(RemoteConfiguredTargetValue.codecWithTransitivePackages())
+          .add(AspectValue.codecWithTransitivePackages())
+          .build();
+    };
+  }
+
+  @Override
+  protected RemoteAnalysisCachingServicesSupplier getAnalysisCachingServicesSupplier(
+      BlazeRuntime runtime) {
+    return services;
+  }
+
+  @Override
+  public Iterable<Class<? extends OptionsBase>> getCommonCommandOptions() {
+    return ImmutableList.of(LocalSkycacheOptions.class);
+  }
+
+  @Override
+  public void beforeCommand(CommandEnvironment env) {
+    RunfilesOrigin.setSharingEnabled(false);
+    environment = null;
+    buildSucceeded = false;
+    services.session = null;
+    services.client = null;
+    services.clientId = null;
+    services.executionValues = false;
+    var options = env.getOptions().getOptions(LocalSkycacheOptions.class);
+    if (options == null
+        || options.getDirectory().isEmpty()
+        || env.getWorkspace() == null
+        || !env.getCommand().buildPhase().executes()) {
+      return;
+    }
+    var caching = env.getOptions().getOptions(RemoteAnalysisCachingOptions.class);
+    try {
+      if (caching.getSkycacheMinimizeMemory()) {
+        throw new IOException("local SkyCache requires the in-memory graph to be retained");
+      }
+      Path workspace = Path.of(env.getWorkspace().getPathString()).toRealPath();
+      Path outputBase = Path.of(env.getOutputBase().getPathString()).toRealPath();
+      Path root =
+          Path.of(env.getWorkingDirectory().getRelative(options.getDirectory()).getPathString())
+              .toAbsolutePath()
+              .normalize();
+      if (root.startsWith(workspace)) {
+        throw new IOException("the shared cache must be outside the source workspace");
+      }
+      LocalCacheSession.durableDirectory(root);
+      if (root.toRealPath().startsWith(workspace)) {
+        throw new IOException("the shared cache resolves inside the source workspace");
+      }
+      // Validate the idle policy before opening a session or taking any cache leases.
+      var collection = LocalCacheGarbageCollectorIdleTask.create(options, root, outputBase);
+      var inputs = new LocalInputSnapshot(workspace, outputBase, inputEnvironment(env));
+      services.session =
+          new LocalCacheSession(
+              root,
+              inputs,
+              System::nanoTime,
+              new LocalCacheSession.ReadLimits(
+                  options.getMaxPublications(), options.getMaxMetadataMb() * 1024L * 1024, 4096));
+      var remote = env.getOptions().getOptions(RemoteOptions.class);
+      services.executionValues =
+          remote != null
+              && remote.getRemoteAcceptCached()
+              && (remote.getRemoteCache() != null || remote.isRemoteExecutionEnabled());
+      RunfilesOrigin.setSharingEnabled(true);
+      if (!inputs.cacheNamespace().equals(services.retainedNamespace)
+          || (retainedPublication != null
+              && !retainedPublication
+                  .getParent()
+                  .equals(services.session.publicationManifest().getParent()))) {
+        services.retainedRoots = Map.of();
+        services.retainedNamespace = inputs.cacheNamespace();
+        retainedPublication = null;
+      }
+      services.client =
+          new LocalAnalysisCacheClient(
+              services.session,
+              new LocalDependencyValidator(
+                  services.session,
+                  inputs,
+                  LOCAL_FINGERPRINTER,
+                  env.getRuntime()
+                      .getBlazeService(
+                          com.google.devtools.build.lib.compress.CompressionService.class)),
+              services.retainedRoots);
+      services.clientId =
+          new ClientId.SnapshotClientId(inputs.cacheNamespace() + "/" + env.getCommandId(), 0);
+      env.setVersionGetter(inputs);
+      setMode(env, "async_bidi");
+      environment = env;
+      env.getEventBus().register(this);
+      if (collection != null) {
+        env.addIdleTask(collection);
+      }
+    } catch (IOException | IllegalArgumentException e) {
+      RunfilesOrigin.setSharingEnabled(false);
+      setMode(env, "off");
+      env.getReporter().handle(Event.warn("Local SkyCache disabled: " + e.getMessage()));
+    }
+  }
+
+  private static Map<String, String> inputEnvironment(CommandEnvironment env) {
+    var inputs = new TreeMap<String, String>();
+    // Use Bazel's effective environments, including explicit overrides and inherited values.
+    // Without strict repo env, getRepoEnv still contains the full client environment.
+    env.getRepoEnv().forEach((name, value) -> inputs.put("repo/" + name, value));
+    env.getAllowlistedActionEnv().forEach((name, value) -> inputs.put("action/" + name, value));
+    env.getAllowlistedTestEnv().forEach((name, value) -> inputs.put("test/" + name, value));
+    // Module resolution reads this client variable directly, outside the repository env.
+    String allowedYankedVersions = env.getClientEnv().get("BZLMOD_ALLOW_YANKED_VERSIONS");
+    if (allowedYankedVersions != null) {
+      inputs.put("bzlmod/BZLMOD_ALLOW_YANKED_VERSIONS", allowedYankedVersions);
+    }
+    // Remote output digests must be resolved against the same CAS namespace. Output download
+    // policy is deliberately excluded: minimal and toplevel share the same remote metadata.
+    var remote = env.getOptions().getOptions(RemoteOptions.class);
+    if (remote != null) {
+      inputs.put("execution/format", "remote-metadata-v1");
+      inputs.put("execution/cache", String.valueOf(remote.getRemoteCache()));
+      inputs.put("execution/executor", String.valueOf(remote.getRemoteExecutor()));
+      inputs.put("execution/instance", remote.getRemoteInstanceName());
+    }
+    return inputs;
+  }
+
+  private static void setMode(CommandEnvironment env, String mode) {
+    // OptionsParser creates a fresh options instance on every getOptions call. Change the parser,
+    // so the factory and the analysis phase observe the same mode.
+    try {
+      ((OptionsParser) env.getOptions())
+          .parse(
+              PriorityCategory.SOFTWARE_REQUIREMENT,
+              "local SkyCache",
+              ImmutableList.of(
+                  "--experimental_remote_analysis_cache_mode=" + mode,
+                  "--experimental_skycache_analysis_only=false"));
+    } catch (OptionsParsingException e) {
+      throw new IllegalStateException("invalid local SkyCache options", e);
+    }
+  }
+
+  @Subscribe
+  public void buildComplete(BuildCompleteEvent event) {
+    buildSucceeded = event.getResult().getSuccess();
+  }
+
+  @Override
+  public void afterCommand() {
+    RunfilesOrigin.setSharingEnabled(false);
+    var env = environment;
+    var session = services.session;
+    if (env != null && session != null) {
+      Path importedPublication = session.importedPublicationManifest();
+      boolean published = false;
+      try {
+        published = session.finish(buildSucceeded);
+      } catch (IOException e) {
+        env.getReporter()
+            .handle(Event.warn("Local SkyCache publication skipped: " + e.getMessage()));
+      }
+      if (session.failureReason() != null) {
+        env.getReporter()
+            .handle(Event.warn("Local SkyCache publication discarded: " + session.failureReason()));
+      }
+      services.retainedRoots = services.client.retainedRoots();
+      if (published) {
+        retainedPublication = session.publicationManifest();
+      } else if (importedPublication != null) {
+        retainedPublication = importedPublication;
+      }
+      var retention =
+          env.getOptions().getOptions(LocalSkycacheOptions.class).getAnalysisCacheIdleRetention();
+      if (buildSucceeded
+          && session.failureReason() == null
+          && retainedPublication != null
+          && !retention.isZero()) {
+        // Capture server-owned objects only, never the command environment or closed session.
+        var workspace = env.getBlazeWorkspace();
+        env.addIdleTask(
+            new AnalysisCacheIdleRetentionTask(
+                retention,
+                retainedPublication,
+                Path.of(env.getOutputBase().getPathString())
+                    .resolve("skycache-idle-retention.json"),
+                () -> {
+                  workspace.resetEvaluator();
+                  services.retainedRoots = Map.of();
+                  services.client = null;
+                  services.session = null;
+                  services.clientId = null;
+                  services.executionValues = false;
+                  // Keep the namespace/backing hint for repeated idle cycles with no new writes.
+                  // The next task reacquires a lease and rechecks existence before resetting.
+                }));
+      }
+      String validation = services.client.validationStatisticsJson();
+      env.getReporter().handle(Event.info("Local SkyCache dependency validation: " + validation));
+      String statistics = session.statisticsJson(published);
+      env.getReporter().handle(Event.info("Local SkyCache: " + statistics));
+      try {
+        Files.writeString(
+            Path.of(env.getOutputBase().getPathString()).resolve("local-skycache-validation.json"),
+            validation);
+        Files.writeString(
+            Path.of(env.getOutputBase().getPathString()).resolve("local-skycache.json"),
+            statistics);
+      } catch (IOException e) {
+        env.getReporter().handle(Event.warn("Could not write local SkyCache statistics"));
+      }
+    }
+    environment = null;
+    super.afterCommand();
+  }
+
+  private static final class Services implements RemoteAnalysisCachingServicesSupplier {
+    private final SafeExecutorOwner executor = new SafeExecutorOwner(commonPool());
+    private final FingerprintValueStore fallback = new InMemoryFingerprintValueStore();
+    @Nullable private LocalCacheSession session;
+    @Nullable private LocalAnalysisCacheClient client;
+    @Nullable private ClientId clientId;
+    private boolean executionValues;
+    private String retainedNamespace = "";
+    private Map<
+            com.google.protobuf.ByteString,
+            com.google.devtools.build.lib.skyframe.serialization.PackedFingerprint>
+        retainedRoots = Map.of();
+
+    @Override
+    public boolean discardFailedUpload(String reason) {
+      var current = session;
+      return current != null && current.discardFailedUpload(reason);
+    }
+
+    @Override
+    public boolean shouldUploadExecutionValue(SkyValue value) {
+      return session == null || (executionValues && LocalExecutionValues.isPortable(value));
+    }
+
+    @Override
+    public boolean retrievesExecutionValues() {
+      return session == null || executionValues;
+    }
+
+    @Override
+    public ListenableFuture<? extends FingerprintValueStore> getFingerprintValueStore() {
+      return immediateFuture(session == null ? fallback : session);
+    }
+
+    @Override
+    public ListenableFuture<? extends RemoteAnalysisCacheClient> getAnalysisCacheClient() {
+      return client == null ? null : immediateFuture(client);
+    }
+
+    @Override
+    public SafeExecutor getCommandExecutor() {
+      return executor;
+    }
+
+    @Override
+    public String getCacheKeyDistinguisher() {
+      return session == null ? "" : session.cacheNamespace();
+    }
+
+    @Override
+    public ClientId getClientIdOverride() {
+      return clientId;
+    }
+
+    @Override
+    public void resetCommandState() {
+      session = null;
+      client = null;
+      clientId = null;
+    }
+  }
+}
