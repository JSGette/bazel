+      synchronized (REGISTRY) {
+        if (released) {
+          return;
+        }
+        released = true;
+        leases.remove(this);
+        if (--held.references == 0) {
+          try {
+            held.lock.release();
+          } catch (IOException e) {
+            state.failure = e;
+            throw e;
+          } finally {
+            state.held.remove(slot);
+          }
+        }
+      }
+    }
+  }
