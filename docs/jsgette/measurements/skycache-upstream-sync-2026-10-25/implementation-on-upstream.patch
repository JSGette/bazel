+  @Test
+  public void analysisCandidatePrefersReadYourWritesAfterSharedPut() throws Exception {
+    Path cache = temporary.newFolder("cache").toPath();
+    var key = NONPROD_FINGERPRINTER.fingerprint(new byte[] {67});
