@@ -0,0 +1,279 @@
+#!/usr/bin/env python3
+"""Repeated full-command idle A/B: matched JVM, outputs, warm graph and uncached control.
+
+Creates a private fixture. Preserves every attempt and never edits an existing run.
+Normal filesystem/page caches remain warm. No machine-wide cache dropping.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import threading
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--bazel', type=Path, required=True)
+    parser.add_argument('--jdk', type=Path, required=True)
+    parser.add_argument('--root', type=Path, required=True)
+    parser.add_argument('--trust-store', type=Path)
+    parser.add_argument('--output-user-root', type=Path,
+                        help='Keep Bazel install/repository caches on the selected run volume')
+    parser.add_argument('--rounds', type=int, default=3)
+    parser.add_argument('--with-off-control', action='store_true')
+    parser.add_argument('--repeated-import-test', action='store_true')
+    args = parser.parse_args()
+    if args.trust_store is None:
+        stores = list(Path('/var/lib/bazel-java-trust').glob('*.p12'))
+        if len(stores) == 1:
+            args.trust_store = stores[0]
+    root = args.root.resolve()
+    root.mkdir(exist_ok=False)
+    workspace = root / 'workspace'
+    workspace.mkdir(exist_ok=False)
+    output = root / 'output-base'
+    cache = root / 'skycache'
+    links = root / 'links'
+    links.mkdir(exist_ok=False)
+    width = 512
+    (workspace / 'MODULE.bazel').write_text('module(name="idle_retention_probe")\n')
+    (workspace / 'BUILD').write_text('exports_files(["defs.bzl"])\n')
+    (workspace / 'defs.bzl').write_text('''Data = provider(fields = ["values"])
+def _leaf(ctx):
+    return [Data(values = ["%s:%d:%s" % (ctx.label.package + ":" + ctx.label.name, i, "x" * 64) for i in range(512)])]
+leaf = rule(implementation = _leaf)
+def _app(ctx):
+    lines = []
+    for dep in ctx.attr.deps:
+        values = dep[Data].values
+        lines.append("%s|%s|%d" % (values[0], values[-1], len(values)))
+    ctx.actions.write(ctx.outputs.out, "\\n".join(lines) + "\\n")
+app = rule(implementation = _app, attrs = {"deps": attr.label_list()}, outputs = {"out": "%{name}.txt"})
+''')
+    deps = []
+    for package in range(64):
+        directory = workspace / f'lib{package:02}'
+        directory.mkdir(exist_ok=False)
+        (directory / 'BUILD').write_text(
+            'load("//:defs.bzl", "leaf")\npackage(default_visibility=["//visibility:public"])\n'
+            + ''.join(f'leaf(name="n{i:02}")\n' for i in range(32)))
+        deps.extend(f'//lib{package:02}:n{i:02}' for i in range(32))
+    (workspace / 'app').mkdir(exist_ok=False)
+    (workspace / 'app/BUILD').write_text(
+        'load("//:defs.bzl", "app")\napp(name="all", deps=' + repr(deps) + ')\n')
+    subprocess.run(['git', 'init', '-q', str(workspace)], check=True)
+    subprocess.run(['git', '-C', str(workspace), 'add', '.'], check=True)
+    subprocess.run(['git', '-C', str(workspace), '-c', 'user.name=Probe',
+                        '-c', 'user.email=probe@example.invalid', 'commit', '-qm', 'fixture'], check=True)
+    base = [str(args.bazel.resolve()), f'--output_base={output}',
+            f'--server_javabase={args.jdk.resolve()}', '--host_jvm_args=-Xmx4g',
+            '--max_idle_secs=600', '--ignore_all_rc_files']
+    if args.output_user_root:
+        base += [f'--output_user_root={args.output_user_root.resolve()}']
+    if args.trust_store:
+        base += [f'--host_jvm_args=-Djavax.net.ssl.trustStore={args.trust_store}',
+                 '--host_jvm_args=-Djavax.net.ssl.trustStoreType=PKCS12',
+                 '--host_jvm_args=-Djavax.net.ssl.trustStorePassword=changeit']
+    flags = ['build', '//app:all', '--jobs=4', '--local_resources=memory=4096',
+             '--color=no', '--curses=no', '--noshow_progress', '--lockfile_mode=error',
+             '--experimental_strict_repo_env', '--experimental_active_directories=app',
+             f'--symlink_prefix={links}/bazel-',
+             f'--experimental_local_skycache={cache}',
+             '--experimental_local_skycache_gc_max_size=0',
+             '--experimental_local_skycache_gc_max_age=0']
+    report = {'kind': 'synthetic_full_command_idle_ab', 'timing': 'blocking_waitpid_with_watchdog', 'attempts': [], 'cycles': [],
+              'binary_sha256': hashlib.sha256(args.bazel.read_bytes()).hexdigest(),
+              'limitations': ['Warm filesystem and action outputs; no OS cache drop.',
+                              'Synthetic Starlark analysis fixture, not a production repository.',
+                              'Heap receipt uses explicit GC; PSS is sampled separately.',
+                              'Sampling every 100 ms may miss brief memory peaks.']}
+    def save():
+        (root / 'results.json').write_text(json.dumps(report, indent=2) + '\n')
+    def memory():
+        try:
+            pid = int((output / 'server/server.pid.txt').read_text())
+            fields = {}
+            for line in Path(f'/proc/{pid}/smaps_rollup').read_text().splitlines():
+                pieces = line.split()
+                if pieces[0] in ('Rss:', 'Pss:', 'Private_Dirty:', 'Private_Clean:'):
+                    fields[pieces[0][:-1].lower() + '_kib'] = int(pieces[1])
+            fields['pid'] = pid
+            fields['cpu_ticks'] = sum(map(int, Path(f'/proc/{pid}/stat').read_text().split()[13:15]))
+            fields['io'] = {k: int(v) for k, v in
+                            (line.split(':') for line in Path(f'/proc/{pid}/io').read_text().splitlines())}
+            return fields
+        except (OSError, ValueError):
+            return None
+
+    def wait_until(predicate, timeout):
+        end = time.monotonic() + timeout
+        while time.monotonic() < end:
+            if predicate():
+                return
+            time.sleep(0.1)
+        raise RuntimeError('Timed out waiting for idle task')
+
+    expected = ''.join(f'{dep[2:]}:0:{"x" * 64}|{dep[2:]}:{width-1}:{"x" * 64}|{width}\n'
+                       for dep in deps).encode()
+    def build(role, retention='0', enabled=True):
+        row = {'role': role, 'before': memory(), 'enabled': enabled, 'retention': retention}
+        report['attempts'].append(row)
+        cmd = base + flags + [f'--experimental_analysis_cache_idle_retention={retention}']
+        if not enabled:
+            cmd += ['--experimental_local_skycache=']
+        row['argv'] = cmd
+        save()
+        samples = []
+        stop = threading.Event()
+        def sample():
+            while not stop.is_set():
+                current = memory()
+                if current:
+                    samples.append(current)
+                stop.wait(0.1)
+        sampler = threading.Thread(target=sample)
+        with (root / f'{role}.log').open('w') as log:
+            started = time.monotonic()
+            process = subprocess.Popen(cmd, cwd=workspace, stdout=log, stderr=subprocess.STDOUT)
+            sampler.start()
+            def expire():
+                row['timed_out'] = True
+                process.terminate()
+                try:
+                    process.wait(timeout=10)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+            watchdog = threading.Timer(300, expire)
+            watchdog.start()
+            try:
+                # wait(timeout=...) polls with up to 50 ms sleeps on POSIX, a large bias for
+                # subsecond builds. A separate watchdog permits an accurate blocking waitpid.
+                process.wait()
+            finally:
+                row['seconds'] = time.monotonic() - started
+                watchdog.cancel()
+                watchdog.join()
+                stop.set()
+                sampler.join()
+        row.update(exit_code=process.returncode, after=memory(),
+                   peak_server_pss_kib=max((s['pss_kib'] for s in samples), default=None))
+        profile = output / 'command.profile.gz'
+        if profile.exists(): shutil.copyfile(profile, root / f'{role}.profile.gz')
+        log_text = (root / f'{role}.log').read_text()
+        row['analysis_hits'] = sum(int(a) for a, _ in re.findall(r'CONFIGURED_TARGET: (\d+)/(\d+)', log_text))
+        if enabled:
+            for name in ('local-skycache.json', 'local-skycache-validation.json'):
+                path = output / name
+                if path.exists(): row[name] = json.loads(path.read_text())
+        save()
+        if process.returncode:
+            raise RuntimeError(f'{role} failed')
+        contents = (links / 'bazel-bin/app/all.txt').read_bytes()
+        row['sha256'] = hashlib.sha256(contents).hexdigest()
+        row['expected_output_matches'] = contents == expected
+        save()
+        if contents != expected:
+            raise RuntimeError(f'{role}: output differs from independent expectation')
+        if row['before'] and row['before']['pid'] != row['after']['pid']:
+            raise RuntimeError(f'{role}: server unexpectedly restarted')
+        if enabled and row.get('local-skycache.json', {}).get('failed'):
+            raise RuntimeError(f'{role}: publication guard failed')
+        return row
+
+    receipt = output / 'skycache-idle-retention.json'
+    def await_idle(cycle):
+        time.sleep(12)  # Ordinary Bazel idle GC runs at 10 seconds.
+        cycle['retained_pss'] = memory()
+        if receipt.exists():
+            raise RuntimeError('Idle reset preceded retained-memory sample')
+        wait_until(receipt.exists, 30)
+        cycle['eviction'] = json.loads(receipt.read_text())
+        time.sleep(1)
+        cycle['evicted_pss'] = memory()
+        save()
+
+    try:
+        # Populate and freeze registry metadata before timing: disabling the lockfile forces
+        # network module resolution after each graph reset and masks analysis-cache cost.
+        setup_cmd = base + ['mod', 'deps', '--lockfile_mode=update',
+                            '--experimental_strict_repo_env', '--noshow_progress']
+        report['setup_argv'] = setup_cmd
+        save()
+        with (root / 'setup.log').open('w') as log:
+            setup = subprocess.run(setup_cmd, cwd=workspace, stdout=log, stderr=subprocess.STDOUT, timeout=300)
+        report['setup_exit_code'] = setup.returncode
+        save()
+        if setup.returncode: raise RuntimeError('Module lockfile preparation failed')
+        seed = build('seed')
+        if not seed['local-skycache.json'].get('published'):
+            raise RuntimeError('Seed did not publish')
+        modes = [True, False] if args.with_off_control else [True]
+        for round_index in range(args.rounds):
+            for enabled in (modes if round_index % 2 == 0 else modes[::-1]):
+                label = f'r{round_index}-' + ('skycache' if enabled else 'off')
+                # Force a small real source revision; the app proof changes, leaf values remain.
+                with (workspace / 'app/BUILD').open('a') as f:
+                    f.write(f'\n# revision {label}\n')
+                writer = build(label + '-writer')
+                if not writer['local-skycache.json'].get('published'):
+                    raise RuntimeError('Revision did not produce durable backing')
+                receipt.unlink(missing_ok=True)
+                warm = build(label + '-warm', '15s')
+                cycle = {'round': round_index, 'enabled': enabled, 'label': label,
+                         'writer_seconds': writer['seconds'], 'warm_seconds': warm['seconds']}
+                report['cycles'].append(cycle)
+                await_idle(cycle)
+                recovery = build(label + '-recovery', enabled=enabled)
+                cycle['recovery_seconds'] = recovery['seconds']
+                cycle['analysis_hits'] = recovery['analysis_hits']
+                if enabled and recovery['analysis_hits'] == 0:
+                    raise RuntimeError('Recovery did not reuse SkyCache analysis')
+                save()
+        if args.repeated_import_test:
+            # The last recovery may import everything with zero novel writes. It must still
+            # schedule another eviction, twice, with no intervening source change/publication.
+            for i in range(2):
+                receipt.unlink(missing_ok=True)
+                build(f'import-cycle-{i}-warm', '15s')
+                cycle = {'label': f'import-cycle-{i}', 'correctness_only': True}
+                report['cycles'].append(cycle)
+                await_idle(cycle)
+                recovered = build(f'import-cycle-{i}-recovery')
+                if not recovered['analysis_hits']:
+                    raise RuntimeError('Repeated idle recovery missed cache')
+            receipt.unlink(missing_ok=True)
+            build('mutation-warm', '15s')
+            mutation_cycle = {'label': 'mutation-eviction', 'correctness_only': True}
+            report['cycles'].append(mutation_cycle)
+            await_idle(mutation_cycle)
+            # Equal-size mutation after graph reset must invalidate disk proofs even with the
+            # original mtime. Loading is cold, so this does not test Bazel's live stat cache.
+            path = workspace / 'defs.bzl'
+            stat = path.stat()
+            path.write_text(path.read_text().replace('"x" * 64', '"y" * 64'))
+            os.utime(path, ns=(stat.st_atime_ns, stat.st_mtime_ns))
+            expected = expected.replace(b'x' * 64, b'y' * 64)
+            build('same-mtime-mutation')
+        report['status'] = 'passed'
+    except Exception as error:
+        report['status'] = 'failed'
+        report['error'] = str(error)
+        raise
+    finally:
+        save()
+        try:
+            cleanup = subprocess.run(base + ['shutdown'], cwd=workspace, stdout=subprocess.DEVNULL,
+                                     stderr=subprocess.DEVNULL, timeout=15)
+            report['shutdown_exit_code'] = cleanup.returncode
+        except subprocess.TimeoutExpired:
+            report['shutdown_warning'] = 'Launcher timed out; check task-owned server process state'
+        save()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/skycache/idle_retention_probe.py b/tools/skycache/idle_retention_probe.py
new file mode 100644
index 0000000..03d2e3a
--- /dev/null
+++ b/tools/skycache/idle_retention_probe.py
@@ -0,0 +1,245 @@
+#!/usr/bin/env python3
+"""Exactly three workload builds: seed, retained warm graph, post-idle recovery.
+
+Synthetic provider-heavy analysis fixture, not a real-repository performance claim.
+Creates its own Git workspace/output base and shuts down only its own Bazel server.
+"""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+import threading
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--bazel', type=Path, required=True)
+    parser.add_argument('--jdk', type=Path, required=True)
+    parser.add_argument('--root', type=Path, required=True)
+    parser.add_argument('--trust-store', type=Path)
+    parser.add_argument('--resume-after-setup-failure', action='store_true')
+    parser.add_argument('--final-memory-only', action='store_true')
+    args = parser.parse_args()
+    if args.trust_store is None:
+        stores = list(Path('/var/lib/bazel-java-trust').glob('*.p12'))
+        if len(stores) == 1:
+            args.trust_store = stores[0]
+    if args.final_memory_only:
+        args.resume_after_setup_failure = True
+    root = args.root.resolve()
+    root.mkdir(exist_ok=args.resume_after_setup_failure)
+    previous = None
+    if args.resume_after_setup_failure:
+        previous = json.loads((root / 'results.json').read_text())
+        assert len(previous['attempts']) == (2 if args.final_memory_only else 1)
+        assert previous['attempts'][0]['exit_code'] != 0
+        assert previous['attempts'][0]['local-skycache.json']['writes'] == 0
+        if args.final_memory_only:
+            assert previous['attempts'][1]['exit_code'] != 0
+        snapshot = 'first-two-failures.json' if args.final_memory_only else 'initial-failure.json'
+        (root / snapshot).write_text(json.dumps(previous, indent=2) + '\n')
+    workspace = root / 'workspace'
+    workspace.mkdir(exist_ok=args.resume_after_setup_failure)
+    output = root / ('output-base-final' if args.final_memory_only else
+                     'output-base-fixed' if previous else 'output-base')
+    cache = root / 'skycache'
+    links = root / 'links'
+    links.mkdir(exist_ok=args.resume_after_setup_failure)
+    leaf_count, width = 2048, 512
+    (workspace / 'MODULE.bazel').write_text('module(name="idle_retention_probe")\n')
+    (workspace / 'BUILD').write_text('exports_files(["defs.bzl"])\n')
+    (workspace / 'defs.bzl').write_text('''Data = provider(fields = ["values"])
+def _leaf(ctx):
+    return [Data(values = ["%s:%d:%s" % (ctx.label.package + ":" + ctx.label.name, i, "x" * 64) for i in range(512)])]
+leaf = rule(implementation = _leaf)
+def _app(ctx):
+    lines = []
+    for dep in ctx.attr.deps:
+        values = dep[Data].values
+        lines.append("%s|%s|%d" % (values[0], values[-1], len(values)))
+    ctx.actions.write(ctx.outputs.out, "\\n".join(lines) + "\\n")
+app = rule(implementation = _app, attrs = {"deps": attr.label_list()}, outputs = {"out": "%{name}.txt"})
+''')
+    deps = []
+    for package in range(64):
+        directory = workspace / f'lib{package:02}'
+        directory.mkdir(exist_ok=args.resume_after_setup_failure)
+        (directory / 'BUILD').write_text(
+            'load("//:defs.bzl", "leaf")\npackage(default_visibility=["//visibility:public"])\n'
+            + ''.join(f'leaf(name="n{i:02}")\n' for i in range(32)))
+        deps.extend(f'//lib{package:02}:n{i:02}' for i in range(32))
+    (workspace / 'app').mkdir(exist_ok=args.resume_after_setup_failure)
+    (workspace / 'app/BUILD').write_text(
+        'load("//:defs.bzl", "app")\napp(name="all", deps=' + repr(deps) + ')\n')
+    if not previous:
+        subprocess.run(['git', 'init', '-q', str(workspace)], check=True)
+        subprocess.run(['git', '-C', str(workspace), 'add', '.'], check=True)
+        subprocess.run(['git', '-C', str(workspace), '-c', 'user.name=Probe',
+                        '-c', 'user.email=probe@example.invalid', 'commit', '-qm', 'fixture'], check=True)
+    base = [str(args.bazel.resolve()), f'--output_base={output}',
+            f'--server_javabase={args.jdk.resolve()}', '--host_jvm_args=-Xmx4g',
+            '--max_idle_secs=600', '--ignore_all_rc_files']
+    if args.trust_store:
+        base += [f'--host_jvm_args=-Djavax.net.ssl.trustStore={args.trust_store}',
+                 '--host_jvm_args=-Djavax.net.ssl.trustStoreType=PKCS12',
+                 '--host_jvm_args=-Djavax.net.ssl.trustStorePassword=changeit']
+    flags = ['build', '//app:all', '--jobs=4', '--local_resources=memory=4096',
+             '--color=no', '--curses=no', '--noshow_progress', '--lockfile_mode=off',
+             '--experimental_strict_repo_env', '--experimental_active_directories=app',
+             f'--symlink_prefix={links}/bazel-',
+             f'--experimental_local_skycache={cache}',
+             '--experimental_local_skycache_gc_max_size=0',
+             '--experimental_local_skycache_gc_max_age=0']
+    report = {'workload_build_cap': 3, 'attempts': [], 'fixture': {
+        'leaf_count': leaf_count, 'strings_per_leaf': width,
+        'description': 'Synthetic analysis-heavy Starlark providers; one FileWrite action'},
+        'limitations': ['Single ordered sample per role; no statistical speedup claim.',
+                        'No uncached-analysis control; A/B tests idle retention only.',
+                        'Filesystem and action outputs remain warm; same JVM throughout.']}
+    if previous:
+        report['attempts'] = previous['attempts']
+        report['amendment'] = ('Initial TLS setup failure consumes attempt 1. Use only two more '
+                               'builds: publication with idle retention, then recovery. No warm '
+                               'build control. New output base and explicit environment CA trust.')
+        report['limitations'] = ['One failed setup attempt plus two successful-build opportunities.',
+            'First successful build includes startup/publication and cold output; next is same-JVM '
+            'SkyCache recovery with warm output. Their timing ratio is not an isolated speedup.',
+            'Before/after idle memory is measured within the first successful server.']
+    if args.final_memory_only:
+        report['amendment'] = ('Attempts 1 and 2 failed (TLS trust then unsupported Starlark format). '
+                               'Use final attempt only to publish and measure pre/post idle memory. '
+                               'No recovery build is permitted within the three-attempt cap.')
+        report['limitations'] = ['Two failed attempts; only one remaining build.',
+                                 'Before/after idle memory only. No measured recovery latency.',
+                                 'Synthetic fixture, not a real-repository benchmark.']
+
+    def save():
+        (root / 'results.json').write_text(json.dumps(report, indent=2) + '\n')
+
+    def memory():
+        try:
+            pid = int((output / 'server/server.pid.txt').read_text())
+            fields = {}
+            for line in Path(f'/proc/{pid}/smaps_rollup').read_text().splitlines():
+                pieces = line.split()
+                if pieces[0] in ('Rss:', 'Pss:', 'Private_Dirty:', 'Private_Clean:'):
+                    fields[pieces[0][:-1].lower() + '_kib'] = int(pieces[1])
+            fields['pid'] = pid
+            fields['cpu_ticks'] = sum(map(int, Path(f'/proc/{pid}/stat').read_text().split()[13:15]))
+            fields['io'] = {k: int(v) for k, v in
+                            (line.split(':') for line in Path(f'/proc/{pid}/io').read_text().splitlines())}
+            return fields
+        except (OSError, ValueError):
+            return None
+
+    def wait_until(predicate, timeout):
+        end = time.monotonic() + timeout
+        while time.monotonic() < end:
+            if predicate():
+                return
+            time.sleep(0.1)
+        raise RuntimeError('Timed out waiting for idle task')
+
+    expected = ''.join(f'{dep[2:]}:0:{"x" * 64}|{dep[2:]}:{width-1}:{"x" * 64}|{width}\n'
+                       for dep in deps).encode()
+    try:
+        schedule = ([('A_seed_before_idle', '20s'), ('B_after_idle', '0')] if previous else
+                    [('seed', '0'), ('A_warm_retained', '20s'), ('B_after_idle', '0')])
+        if args.final_memory_only:
+            schedule = [('memory_only_seed', '20s')]
+        for role, retention in schedule:
+            assert len(report['attempts']) < 3
+            row = {'role': role, 'retention': retention, 'before': memory()}
+            report['attempts'].append(row)
+            save()  # Every attempted build counts, including failure or timeout.
+            cmd = base + flags + [f'--experimental_analysis_cache_idle_retention={retention}']
+            row['argv'] = cmd
+            start = time.monotonic()
+            samples = []
+            with (root / f'{role}.log').open('w') as log:
+                process = subprocess.Popen(cmd, cwd=workspace, stdout=log, stderr=subprocess.STDOUT)
+                stop = threading.Event()
+                def sample_memory():
+                    while not stop.is_set():
+                        sample = memory()
+                        if sample:
+                            samples.append(sample)
+                        stop.wait(0.1)
+                sampler = threading.Thread(target=sample_memory)
+                sampler.start()
+                try:
+                    process.wait(timeout=300)
+                except subprocess.TimeoutExpired:
+                    process.terminate()
+                    try:
+                        process.wait(timeout=15)
+                    except subprocess.TimeoutExpired:
+                        process.kill()
+                        process.wait()
+                    row['timed_out'] = True
+                elapsed = time.monotonic() - start
+                stop.set()
+                sampler.join()
+            row.update(seconds=elapsed, exit_code=process.returncode, after=memory(),
+                       peak_server_pss_kib=max((s['pss_kib'] for s in samples), default=None))
+            log_text = (root / f'{role}.log').read_text()
+            hits = re.findall(r'CONFIGURED_TARGET: (\d+)/(\d+)', log_text)
+            row['analysis_hits'] = sum(int(hit) for hit, _ in hits)
+            for name in ['local-skycache.json', 'local-skycache-validation.json']:
+                if (output / name).exists():
+                    row[name] = json.loads((output / name).read_text())
+            save()
+            if process.returncode != 0:
+                raise RuntimeError(f'{role} failed; no additional workload builds')
+            artifact = links / 'bazel-bin/app/all.txt'
+            contents = artifact.read_bytes()
+            row['sha256'] = hashlib.sha256(contents).hexdigest()
+            row['expected_output_matches'] = contents == expected
+            save()
+            if contents != expected:
+                raise RuntimeError('Output differs from independently generated expected bytes')
+            if role == 'B_after_idle':
+                if row['analysis_hits'] == 0:
+                    raise RuntimeError('Post-idle build did not reuse SkyCache analysis')
+                baseline = report['attempts'][1 if previous else 0]
+                if row['after']['pid'] != baseline['after']['pid']:
+                    raise RuntimeError('Server restarted instead of retaining the JVM')
+            if role in ('seed', 'A_seed_before_idle', 'memory_only_seed'):
+                if not row['local-skycache.json'].get('published'):
+                    raise RuntimeError('Seed did not publish')
+            if role == 'seed':
+                time.sleep(12)  # Let the normal 10-second idle GC finish before the warm control.
+            elif role in ('A_warm_retained', 'A_seed_before_idle', 'memory_only_seed'):
+                time.sleep(12)
+                report['retained_idle_memory'] = memory()
+                receipt = output / 'skycache-idle-retention.json'
+                if receipt.exists():
+                    raise RuntimeError('Eviction happened before the retained-memory observation')
+                wait_until(receipt.exists, 45)
+                report['eviction'] = json.loads(receipt.read_text())
+                time.sleep(2)
+                report['evicted_idle_memory'] = memory()
+                save()
+        report['status'] = ('memory_only_completed_with_two_failed_attempts' if args.final_memory_only
+                            else 'completed_with_setup_failure' if previous else 'passed')
+    except Exception as error:
+        report['status'] = 'failed'
+        report['error'] = str(error)
+        raise
+    finally:
+        save()
+        try:
+            cleanup = subprocess.run(base + ['shutdown'], cwd=workspace, stdout=subprocess.DEVNULL,
+                                     stderr=subprocess.DEVNULL, timeout=15)
+            report['shutdown_exit_code'] = cleanup.returncode
+        except subprocess.TimeoutExpired:
+            report['shutdown_warning'] = 'Launcher timed out waiting for server exit; inspect PID state'
+        save()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/skycache/local_execution_probe.py b/tools/skycache/local_execution_probe.py
new file mode 100644
index 0000000..68a0054
--- /dev/null
+++ b/tools/skycache/local_execution_probe.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Exercise clean-build metadata hits and lost-blob rewinding with a private HTTP cache."""
+import argparse
+import hashlib
+import http.server
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import threading
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--bazel', type=Path, required=True)
+    parser.add_argument('--jdk', type=Path, required=True)
+    parser.add_argument('--root', type=Path, required=True)
+    args = parser.parse_args()
+    root = args.root.resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    ws = root / 'workspace'
+    ws.mkdir()
+    (root / 'tmp').mkdir()
+    out = root / 'output'
+    cache = root / 'skycache'
+    blobs, requests = {}, []
+
+    class Cache(http.server.BaseHTTPRequestHandler):
+        protocol_version = 'HTTP/1.1'
+
+        def log_message(self, *_):
+            pass
+
+        def reply(self, code, data=b''):
+            self.send_response(code)
+            self.send_header('Content-Length', str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+        def do_PUT(self):
+            data = self.rfile.read(int(self.headers['Content-Length']))
+            blobs[self.path] = data
+            requests.append({'method': 'PUT', 'path': self.path, 'status': 200, 'bytes': len(data)})
+            self.reply(200)
+
+        def do_GET(self):
+            data = blobs.get(self.path)
+            code = 404 if data is None else 200
+            requests.append({'method': 'GET', 'path': self.path, 'status': code,
+                             'bytes': 0 if data is None else len(data)})
+            self.reply(code, data or b'')
+
+    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Cache)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    endpoint = f'http://127.0.0.1:{server.server_port}'
+    (ws / 'MODULE.bazel').write_text('module(name="execution_probe")\n')
+    (ws / 'source.txt').write_text('source-v1\n')
+    (ws / 'rules.bzl').write_text(r'''def _copy(ctx):
+    out = ctx.actions.declare_file(("deep/nested/" if ctx.label.name == "middle" else "") + ctx.label.name + ".txt")
+    ctx.actions.run_shell(inputs = [ctx.file.src], outputs = [out],
+        command = 'cat "$1" > "$2"; echo "$3" >> "$2"',
+        arguments = [ctx.file.src.path, out.path, ctx.label.name],
+        execution_requirements = {"no-remote": "1"} if ctx.attr.local else {})
+    return [DefaultInfo(files = depset([out]))]
+copy = rule(implementation = _copy, attrs = {
+    "src": attr.label(allow_single_file = True), "local": attr.bool()})
+def _write(ctx):
+    out = ctx.actions.declare_file(ctx.label.name + ".txt")
+    ctx.actions.write(out, "internal-write\n")
+    return [DefaultInfo(files = depset([out]))]
+write = rule(implementation = _write)
+def _link(ctx):
+    out = ctx.actions.declare_file(ctx.label.name + ".txt")
+    ctx.actions.symlink(output=out, target_file=ctx.file.src)
+    return [DefaultInfo(files=depset([out]))]
+link = rule(implementation=_link, attrs={"src": attr.label(allow_single_file=True)})
+''')
+    (ws / 'BUILD.bazel').write_text('''load(":rules.bzl", "copy", "write", "link")
+copy(name="middle", src="source.txt")
+copy(name="final", src=":middle")
+copy(name="consumer", src=":middle", local=True)
+write(name="internal")
+link(name="alias", src=":middle")
+''')
+    # Keep the environment stable across all invocations and cache admissions.
+    env = dict(os.environ, TMPDIR=str(root / 'tmp'))
+    for key in ['PWD', 'OLDPWD', 'XDG_CACHE_HOME']:
+        env.pop(key, None)
+    startup = [str(args.bazel.resolve()), '--nosystem_rc', '--nohome_rc', '--noworkspace_rc',
+               '--output_base=' + str(out), '--server_javabase=' + str(args.jdk.resolve()),
+               '--host_jvm_args=-Xmx2g', '--max_idle_secs=120']
+    protocol = {'status': 'running', 'binary': str(args.bazel),
+                'binary_sha256': hashlib.sha256(args.bazel.read_bytes()).hexdigest(),
+                'remote_cache': endpoint, 'runs': []}
+
+    def save():
+        (root / 'results.json').write_text(json.dumps(protocol, indent=2) + '\n')
+
+    def call(label, argv):
+        start = time.monotonic()
+        with (root / (label + '.log')).open('w') as log:
+            p = subprocess.run(startup + argv, cwd=ws, env=env, stdout=log,
+                               stderr=subprocess.STDOUT, timeout=180)
+        row = {'label': label, 'argv': startup + argv, 'seconds': time.monotonic()-start,
+               'exit_code': p.returncode}
+        protocol['runs'].append(row)
+        save()
+        assert p.returncode == 0, label
+        return row
+
+    def build(label, target='final', mode='minimal', enabled=True, accept=True):
+        call(label + '-clean', ['clean', '--noasync', '--noexpunge'])
+        assert not (out / 'action_cache').exists()
+        assert not (out / 'execroot').exists() or not list((out / 'execroot').iterdir())
+        call(label + '-graph', ['dump', '--skyframe=summary'])
+        assert 'Node count: 0' in (root / (label + '-graph.log')).read_text()
+        mark = len(requests)
+        row = call(label, ['build', '//:' + target, '--jobs=4', '--color=no', '--curses=no',
+                          '--disk_cache=', '--remote_cache=' + endpoint, '--remote_retries=0',
+                          '--remote_download_outputs=' + mode, '--remote_upload_local_results',
+                          '--remote_accept_cached=' + str(accept).lower(),
+                          '--experimental_strict_repo_env',
+                          '--experimental_local_skycache=' + (str(cache) if enabled else ''),
+                          '--experimental_analysis_cache_idle_retention=0',
+                          '--build_event_json_file=' + str(root / (label + '.bep.json'))])
+        row['requests'] = requests[mark:]
+        row['action_cache_gets'] = sum(r['method']=='GET' and '/ac/' in r['path'] for r in row['requests'])
+        row['cas_gets'] = sum(r['method']=='GET' and '/cas/' in r['path'] for r in row['requests'])
+        row['missing_blob_reads'] = sum(r['status']==404 and '/cas/' in r['path'] for r in row['requests'])
+        output = out / ('execroot/_main/bazel-out/k8-fastbuild/bin/' + target + '.txt')
+        row['output_exists'] = output.exists()
+        row['contents'] = output.read_text() if output.exists() else None
+        if enabled:
+            shutil.copy2(out / 'local-skycache.json', root / (label + '.skycache.json'))
+        print(json.dumps(row), flush=True)
+        save()
+        return row
+
+    try:
+        build('populate-remote', enabled=False)
+        prime = build('prime-metadata')
+        assert prime['action_cache_gets'] == 2
+        hit = build('minimal-hit')
+        assert hit['action_cache_gets'] == hit['cas_gets'] == 0, hit
+        assert not hit['output_exists']
+        top = build('toplevel-hit', mode='toplevel')
+        assert top['action_cache_gets'] == 0 and top['cas_gets'] == 1, top
+        assert top['contents'] == 'source-v1\nmiddle\nfinal\n'
+        link = build('symlink-to-unmaterialized-input', target='alias')
+        assert link['action_cache_gets'] == link['cas_gets'] == 0
+        middle_digest = hashlib.sha256(b'source-v1\nmiddle\n').hexdigest()
+        middle_key = '/cas/' + middle_digest
+        assert middle_key in blobs
+        del blobs[middle_key]
+        absent = build('unused-missing-intermediate')
+        assert absent['action_cache_gets'] == absent['cas_gets'] == 0
+        recovered = build('required-missing-intermediate', target='consumer', mode='toplevel')
+        assert recovered['missing_blob_reads'] >= 1, recovered
+        assert recovered['contents'] == 'source-v1\nmiddle\nconsumer\n'
+        assert middle_key in blobs, 'rewind did not restore the missing output'
+        final_key = '/cas/' + hashlib.sha256(b'source-v1\nmiddle\nfinal\n').hexdigest()
+        del blobs[final_key]
+        recovered_top = build('missing-toplevel', mode='toplevel')
+        assert recovered_top['missing_blob_reads'] >= 1
+        assert recovered_top['contents'] == 'source-v1\nmiddle\nfinal\n'
+        assert final_key in blobs
+        uncached = build('remote-cache-disabled', mode='minimal', accept=False)
+        assert uncached['action_cache_gets'] == 0
+        assert uncached['contents'] == 'source-v1\nmiddle\nfinal\n'
+        internal = build('internal-output', target='internal', mode='minimal')
+        assert internal['contents'] == 'internal-write\n'
+        internal = build('internal-after-clean', target='internal', mode='minimal')
+        assert internal['contents'] == 'internal-write\n'
+        (ws / 'source.txt').write_text('source-v2\n')
+        changed = build('changed-source', mode='toplevel')
+        assert changed['contents'] == 'source-v2\nmiddle\nfinal\n'
+        assert changed['action_cache_gets'] >= 1
+        protocol['status'] = 'passed'
+    except BaseException as error:
+        protocol['status'] = 'failed'
+        protocol['failure'] = repr(error)
+        raise
+    finally:
+        call('shutdown', ['shutdown'])
+        server.shutdown()
+        save()
+
+
+if __name__ == '__main__':
+    main()
