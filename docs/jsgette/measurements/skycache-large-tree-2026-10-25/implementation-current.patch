@@ -0,0 +1,140 @@
+// Copyright 2026 The Bazel Authors. All rights reserved.
+// Licensed under the Apache License, Version 2.0. See the repository LICENSE.
+package com.google.devtools.build.lib.skyframe.serialization.local;
+
+import static com.google.devtools.build.lib.skyframe.serialization.FingerprintValueService.NONPROD_FINGERPRINTER;
+
+import com.google.devtools.build.lib.compress.CompressionServiceImpl;
+import com.google.devtools.build.lib.skyframe.serialization.PackedFingerprint;
+import com.google.devtools.build.lib.skyframe.serialization.StringKey;
+import com.google.protobuf.CodedOutputStream;
+import java.io.ByteArrayOutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.Callable;
+import java.util.concurrent.Executors;
+
+/**
+ * Actual packed I/O, dependency decoding and filesystem validation; warm filesystem, fresh memos.
+ */
+public final class ParallelDependencyValidationBenchmark {
+  private static byte[] node(List<PackedFingerprint> nested, List<StringKey> leaves)
+      throws Exception {
+    var bytes = new ByteArrayOutputStream();
+    var out = CodedOutputStream.newInstance(bytes);
+    out.writeInt32NoTag(nested.size());
+    out.writeInt32NoTag(leaves.size());
+    out.writeInt32NoTag(0);
+    out.writeBoolNoTag(false);
+    for (var child : nested) child.writeTo(out);
+    for (var leaf : leaves) out.writeStringNoTag(leaf.key());
+    out.flush();
+    return bytes.toByteArray();
+  }
+
+  private static PackedFingerprint put(PackedFingerprintValueStore store, byte[] bytes)
+      throws Exception {
+    var key = NONPROD_FINGERPRINTER.fingerprint(bytes);
+    store.put(key, bytes).get();
+    return key;
+  }
+
+  public static void main(String[] args) throws Exception {
+    Path directory = Files.createDirectory(Path.of(args[0]));
+    Path workspace = Files.createDirectory(directory.resolve("workspace"));
+    Path output = Files.createDirectory(directory.resolve("output"));
+    Path packs = Files.createDirectory(directory.resolve("packs"));
+    var roots = new ArrayList<PackedFingerprint>();
+    String id = "ab".repeat(32);
+    int count = 8192;
+    for (int i = 0; i < count; i++) {
+      Files.writeString(workspace.resolve("file-" + i), "content-" + i + "x".repeat(256));
+    }
+    try (var writer = PackedFingerprintValueStore.create(packs, id)) {
+      var inputs = new LocalInputSnapshot(workspace, output, Map.of());
+      var leaves = new ArrayList<StringKey>();
+      for (int i = 0; i < count; i++) {
+        byte[] evidence =
+            inputs.captureDependency(workspace.resolve("file-" + i), false, List.of());
+        var key =
+            new StringKey("local-input-v1/" + NONPROD_FINGERPRINTER.fingerprint(evidence).toHex());
+        writer.put(key, evidence).get();
+        leaves.add(key);
+      }
+      var groups = new ArrayList<PackedFingerprint>();
+      for (int group = 0; group < 128; group++) {
+        groups.add(put(writer, node(List.of(), leaves.subList(group * 64, (group + 1) * 64))));
+      }
+      for (int root = 0; root < 512; root++) {
+        var dependencies = new ArrayList<PackedFingerprint>();
+        for (int j = 0; j < 8; j++) dependencies.add(groups.get((root + j) % groups.size()));
+        roots.add(put(writer, node(dependencies, List.of(leaves.get(root)))));
+      }
+      writer.seal();
+    }
+    var compression = new CompressionServiceImpl();
+    try (var store = PackedFingerprintValueStore.open(packs, id)) {
+      for (int round = -2; round < 5; round++) {
+        // Reverse concurrency order on alternate rounds to reduce warmup/order bias.
+        int[] widths = round % 2 == 0 ? new int[] {1, 2, 4, 8} : new int[] {8, 4, 2, 1};
+        for (int width : widths) {
+          for (int position = 0; position < 2; position++) {
+            boolean serial = Math.floorMod(round + position, 2) == 0;
+            var inputs = new LocalInputSnapshot(workspace, output, Map.of());
+            var baseline =
+                new SerialDependencyValidatorBenchmarkBaseline(
+                    store, inputs, NONPROD_FINGERPRINTER, compression);
+            var parallel =
+                new LocalDependencyValidator(store, inputs, NONPROD_FINGERPRINTER, compression);
+            long start;
+            long elapsed;
+            try (var pool = Executors.newFixedThreadPool(width)) {
+              // Start workers before timing, then partition roots without per-root task allocation.
+              var ready = new java.util.concurrent.CountDownLatch(width);
+              var go = new java.util.concurrent.CountDownLatch(1);
+              var tasks = new ArrayList<java.util.concurrent.Future<Void>>();
+              for (int worker = 0; worker < width; worker++) {
+                final int offset = worker;
+                tasks.add(
+                    pool.submit(
+                        (Callable<Void>)
+                            () -> {
+                              ready.countDown();
+                              go.await();
+                              for (int i = offset; i < roots.size(); i += width) {
+                                boolean valid =
+                                    serial
+                                        ? baseline.validate(roots.get(i))
+                                        : parallel.validate(roots.get(i));
+                                if (!valid) throw new AssertionError("root failed: " + i);
+                              }
+                              return null;
+                            }));
+              }
+              ready.await();
+              start = System.nanoTime();
+              go.countDown();
+              for (var task : tasks) task.get();
+              elapsed = System.nanoTime() - start;
+            }
+            if (!inputs.isUnchanged()) throw new AssertionError("final revalidation failed");
+            if (round >= 0)
+              System.out.printf(
+                  Locale.ROOT,
+                  "{\"round\":%d,\"implementation\":\"%s\",\"threads\":%d,\"roots\":%d,\"validation_ms\":%.3f,\"statistics\":%s}%n",
+                  round,
+                  serial ? "serial_baseline" : "root_stripes",
+                  width,
+                  roots.size(),
+                  elapsed / 1e6,
+                  serial ? baseline.statisticsJson() : parallel.statisticsJson());
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/src/test/java/com/google/devtools/build/lib/skyframe/serialization/local/ParallelPackedStoreBenchmark.java b/src/test/java/com/google/devtools/build/lib/skyframe/serialization/local/ParallelPackedStoreBenchmark.java
new file mode 100644
index 0000000..24d1e9e
--- /dev/null
+++ b/src/test/java/com/google/devtools/build/lib/skyframe/serialization/local/ParallelPackedStoreBenchmark.java
@@ -0,0 +1,116 @@
+// Copyright 2026 The Bazel Authors. All rights reserved.
+// Licensed under the Apache License, Version 2.0. See the repository LICENSE.
+package com.google.devtools.build.lib.skyframe.serialization.local;
+
+import com.google.devtools.build.lib.skyframe.serialization.KeyBytesProvider;
+import java.nio.ByteBuffer;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** Repeated positional pack writes (including seal), then verified concurrent reads. */
+public final class ParallelPackedStoreBenchmark {
+  private record Key(int index) implements KeyBytesProvider {
+    @Override
+    public byte[] toBytes() {
+      return ByteBuffer.allocate(4).putInt(index).array();
+    }
+
+    @Override
+    public byte[] concat(byte[] suffix) {
+      return ByteBuffer.allocate(4 + suffix.length).putInt(index).put(suffix).array();
+    }
+  }
+
+  private interface Operation {
+    void run(int i) throws Exception;
+  }
+
+  private static double measure(ExecutorService pool, int width, int count, Operation operation)
+      throws Exception {
+    var ready = new java.util.concurrent.CountDownLatch(width);
+    var go = new java.util.concurrent.CountDownLatch(1);
+    var tasks = new ArrayList<java.util.concurrent.Future<?>>();
+    for (int worker = 0; worker < width; worker++) {
+      final int offset = worker;
+      tasks.add(
+          pool.submit(
+              () -> {
+                ready.countDown();
+                go.await();
+                for (int i = offset; i < count; i += width) operation.run(i);
+                return null;
+              }));
+    }
+    ready.await();
+    long start = System.nanoTime();
+    go.countDown();
+    for (var task : tasks) task.get();
+    return (System.nanoTime() - start) / 1e6;
+  }
+
+  public static void main(String[] args) throws Exception {
+    Path root = Files.createDirectory(Path.of(args[0]));
+    int count = Integer.parseInt(args[1]), size = Integer.parseInt(args[2]);
+    byte[] value = new byte[size];
+    for (int i = 0; i < size; i++) value[i] = (byte) (i * 31);
+    int number = 0;
+    for (int round = -2; round < 5; round++) {
+      int[] widths = round % 2 == 0 ? new int[] {1, 2, 4, 8} : new int[] {8, 4, 2, 1};
+      for (int width : widths) {
+        String id = String.format(Locale.ROOT, "%064x", ++number);
+        try (var pool = Executors.newFixedThreadPool(width)) {
+          double write, seal, open, read;
+          try (var writer = PackedFingerprintValueStore.create(root, id)) {
+            write =
+                measure(
+                    pool,
+                    width,
+                    count,
+                    i -> {
+                      if (!writer.put(new Key(i), value).get())
+                        throw new AssertionError("not novel");
+                    });
+            long start = System.nanoTime();
+            writer.seal();
+            seal = (System.nanoTime() - start) / 1e6;
+          }
+          long start = System.nanoTime();
+          try (var reader = PackedFingerprintValueStore.open(root, id)) {
+            open = (System.nanoTime() - start) / 1e6;
+            read =
+                measure(
+                    pool,
+                    width,
+                    count,
+                    i -> {
+                      if (!Arrays.equals(reader.get(new Key(i)).get(), value))
+                        throw new AssertionError("bad bytes");
+                    });
+          }
+          if (round >= 0)
+            System.out.printf(
+                Locale.ROOT,
+                "{\"round\":%d,\"threads\":%d,\"entries\":%d,\"value_bytes\":%d,\"write_ms\":%.3f,\"seal_ms\":%.3f,\"durable_write_ms\":%.3f,\"open_ms\":%.3f,\"read_ms\":%.3f}%n",
+                round,
+                width,
+                count,
+                size,
+                write,
+                seal,
+                write + seal,
+                open,
+                read);
+        }
+        // Only this fixture's closed pack is removed; each round starts with a new publication.
+        Files.delete(root.resolve(id).resolve("data.pack"));
+        Files.delete(root.resolve(id).resolve("index"));
+        Files.delete(root.resolve(id));
+      }
+    }
+  }
+}
diff --git a/src/test/java/com/google/devtools/build/lib/skyframe/serialization/local/SegmentedFingerprintValueStoreTest.java b/src/test/java/com/google/devtools/build/lib/skyframe/serialization/local/SegmentedFingerprintValueStoreTest.java
new file mode 100644
index 0000000..a2c7981
--- /dev/null
+++ b/src/test/java/com/google/devtools/build/lib/skyframe/serialization/local/SegmentedFingerprintValueStoreTest.java
@@ -0,0 +1,88 @@
+// Copyright 2026 The Bazel Authors. All rights reserved.
+// Licensed under the Apache License, Version 2.0. See the repository LICENSE.
+package com.google.devtools.build.lib.skyframe.serialization.local;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import com.google.devtools.build.lib.skyframe.serialization.StringKey;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.Executors;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+@RunWith(JUnit4.class)
+public final class SegmentedFingerprintValueStoreTest {
+  @Rule public final TemporaryFolder temporary = new TemporaryFolder();
+
+  @Test
+  public void concurrentRotationRetainsValuesAndDeduplicationAcrossSealedSegments()
+      throws Exception {
+    var directory = temporary.newFolder().toPath();
+    String id = "1".repeat(64);
+    try (var writer = SegmentedFingerprintValueStore.create(directory, id, 8, 1024);
+        var executor = Executors.newFixedThreadPool(8)) {
+      var tasks = new ArrayList<Callable<Void>>();
+      for (int n = 0; n < 512; n++) {
+        int value = n;
+        tasks.add(
+            () -> {
+              var key = new StringKey("key-" + value);
+              byte[] bytes = ("value-" + value).getBytes(java.nio.charset.StandardCharsets.UTF_8);
+              assertThat(writer.put(key, bytes).get()).isTrue();
+              assertThat(writer.get(key).get()).isEqualTo(bytes);
+              return null;
+            });
+      }
+      for (var done : executor.invokeAll(tasks)) {
+        done.get();
+      }
+      var first = new StringKey("key-0");
+      assertThat(
+              writer.put(first, "value-0".getBytes(java.nio.charset.StandardCharsets.UTF_8)).get())
+          .isFalse();
+      assertThrows(ExecutionException.class, () -> writer.put(first, new byte[] {99}).get());
+      assertThrows(
+          IOException.class, () -> SegmentedFingerprintValueStore.open(directory, id, 1000000));
+      writer.seal();
+      long metadata = writer.indexBytes();
+      assertThrows(
+          IOException.class,
+          () -> SegmentedFingerprintValueStore.open(directory, id, metadata - 1));
+      try (var reader = SegmentedFingerprintValueStore.open(directory, id, metadata)) {
+        for (int n = 0; n < 512; n++) {
+          assertThat(reader.get(new StringKey("key-" + n)).get())
+              .isEqualTo(("value-" + n).getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        }
+      }
+    }
+    try (var files = Files.list(directory.resolve(id))) {
+      assertThat(files.filter(f -> f.toString().endsWith(".pack")).count()).isGreaterThan(16);
+    }
+  }
+
+  @Test
+  public void indexIsAuthenticatedLazilyAgainstThePublicationDescriptor() throws Exception {
+    var directory = temporary.newFolder().toPath();
+    String id = "2".repeat(64);
+    var key = new StringKey("one");
+    try (var writer = SegmentedFingerprintValueStore.create(directory, id)) {
+      writer.put(key, new byte[] {1}).get();
+      writer.seal();
+    }
+    var index = directory.resolve(id).resolve("segment-00000.index");
+    byte[] damaged = Files.readAllBytes(index);
+    damaged[20] ^= 1;
+    Files.write(index, damaged);
+    try (var reader = SegmentedFingerprintValueStore.open(directory, id, 100000)) {
+      assertThrows(ExecutionException.class, () -> reader.get(key).get());
+    }
+  }
+}
