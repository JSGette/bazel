+  @Test
+  public void observerAndFailureReporterExceptionsDoNotEscapeOrRepeat() {
+    AtomicInteger calls = new AtomicInteger();
+    AtomicInteger failures = new AtomicInteger();
+    EvaluationProgressReceiver delegate =
+        new EvaluationProgressReceiver() {
+          @Override
+          public void enqueueing(SkyKey key) {
+            calls.incrementAndGet();
+            throw new IllegalStateException("observer failure");
+          }
+        };
+    var receiver =
+        new M1TraceModule.FailureIsolatingReceiver(
+            delegate,
+            failure -> {
+              failures.incrementAndGet();
+              throw new IllegalStateException("failure reporter failure");
+            });
+    SkyKey key = mock(SkyKey.class);
+    receiver.enqueueing(key);
+    receiver.enqueueing(key);
+    assertThat(calls.get()).isEqualTo(1);
+    assertThat(failures.get()).isEqualTo(1);
+    assertThat(receiver.hasFailed()).isTrue();
+  }
