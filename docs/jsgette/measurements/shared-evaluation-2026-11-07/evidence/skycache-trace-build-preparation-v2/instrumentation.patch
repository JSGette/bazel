+  @Override
+  public void beforeCommand(CommandEnvironment env) {
+    // Defensive cleanup if an earlier command did not reach its ordinary module cleanup.
+    if (session != null) {
+      session.collector.markIncomplete("previous_command_missing_module_cleanup");
+      afterCommand();
+    }
+    Options options = env.getOptions().getOptions(Options.class);
+    if (options == null || options.output.isEmpty()) {
+      return; // No evaluator access, attachment, collector or graph walk while disabled.
+    }
+    Writer writer = null;
+    M1TraceCollector collector = null;
+    try {
+      if (env.getWorkspace() == null) {
+        throw new IOException("Tracing requires a workspace");
+      }
+      if (OS.getCurrent() != OS.LINUX) {
+        throw new IOException("The initial trace binding supports Linux only");
+      }
