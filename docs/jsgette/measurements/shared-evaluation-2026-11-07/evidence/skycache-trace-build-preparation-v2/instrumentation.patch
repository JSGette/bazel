+  @Test
+  public void commandsDetachAndUseIndependentTraceIdsAndReceipts() throws Exception {
+    assumeTrue(OS.getCurrent() == OS.LINUX);
+    CommandEnvironment env = mock(CommandEnvironment.class);
+    SkyframeExecutor executor = mock(SkyframeExecutor.class);
+    MemoizingEvaluator evaluator = mock(MemoizingEvaluator.class);
+    InMemoryGraph graph = mock(InMemoryGraph.class);
+    when(env.getWorkspace())
+        .thenReturn(new InMemoryFileSystem(DigestHashFunction.SHA256).getPath("/workspace"));
+    when(env.getReporter()).thenReturn(mock(Reporter.class));
+    when(env.getSkyframeExecutor()).thenReturn(executor);
+    when(executor.getEvaluator()).thenReturn(evaluator);
+    when(evaluator.getInMemoryGraph()).thenReturn(graph);
+    when(graph.getAllNodeEntries()).thenReturn(List.of());
+    when(executor.compareAndSetM1TraceProgressReceiver(isNull(), any())).thenReturn(true);
+    Path context = contextFile("/workspace");
+    M1TraceModule module = new M1TraceModule();
+    String priorTraceId = null;
+    for (int i = 0; i < 2; i++) {
+      Path output = path("trace-" + i + ".jsonl");
+      UUID command = UUID.randomUUID();
+      when(env.getCommandId()).thenReturn(command);
+      when(env.getOptions())
+          .thenReturn(
+              options(
+                  "--experimental_m1_trace=" + output,
+                  "--experimental_m1_trace_context=" + context));
+      module.beforeCommand(env);
+      verify(graph, times(i)).getAllNodeEntries(); // No constructor/disabled graph walk.
+      assertThat(Files.exists(M1TraceModule.completionPath(output))).isFalse();
+      module.afterCommand();
+      module.afterCommand(); // Idempotent and cannot detach another command's observer.
+      var header = JsonParser.parseString(Files.readAllLines(output).get(0)).getAsJsonObject();
+      var receipt =
+          JsonParser.parseString(Files.readString(M1TraceModule.completionPath(output)))
+              .getAsJsonObject();
+      assertThat(header.get("trace_id").getAsString()).isNotEqualTo(priorTraceId);
+      priorTraceId = header.get("trace_id").getAsString();
+      assertThat(receipt.get("command_id").getAsString()).isEqualTo(command.toString());
+      assertThat(receipt.get("context_sha256")).isEqualTo(header.get("context_sha256"));
+      assertThat(receipt.get("completion").getAsBoolean()).isTrue();
+    }
+    verify(executor, times(2)).compareAndSetM1TraceProgressReceiver(any(), isNull());
+  }
