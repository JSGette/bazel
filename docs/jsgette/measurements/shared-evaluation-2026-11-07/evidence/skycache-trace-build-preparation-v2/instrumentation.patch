+      Context context = readContext(Path.of(options.context), env.getWorkspace().getPathString());
+      Map<String, Object> header = context.header();
+      Map<?, ?> bindings = (Map<?, ?>) header.get("repository_bindings");
+      Map<?, ?> main = (Map<?, ?>) bindings.get("main");
+      Map<?, ?> filesystem = (Map<?, ?>) main.get("filesystem_policy");
+      if (!env.getWorkspace()
+          .getFileSystem()
+          .getDigestFunction()
+          .toString()
+          .equals(filesystem.get("digest_algorithm"))) {
+        throw new IOException(
+            "Trace context digest algorithm differs from the workspace filesystem");
+      }
+      header.put("trace_id", UUID.randomUUID().toString());
+      header.put("command_id", env.getCommandId().toString());
+      header.put("context_sha256", context.sha256());
+      header.put("context_status", "declared");
+      header.put("capture_window", "module_after_cache_setup_to_after_cache_finalization");
+      header.put("direct_skycache_witness_validation", "unobserved");
+      Path output = canonicalFile(Path.of(options.output));
+      if (output.startsWith(Path.of(env.getWorkspace().getPathString()))) {
+        throw new IOException("Trace output must be outside the source workspace");
+      }
+      if (Files.exists(completionPath(output), LinkOption.NOFOLLOW_LINKS)) {
+        throw new IOException("Trace completion receipt already exists");
+      }
