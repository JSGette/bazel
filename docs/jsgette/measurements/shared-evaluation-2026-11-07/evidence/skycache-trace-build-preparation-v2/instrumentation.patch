+      collector =
+          new M1TraceCollector(
+              writer, workspaceRoot, () -> executor.getEvaluator().getInMemoryGraph(), header);
+      Session next =
+          new Session(
+              collector, executor, writer, output, env.getCommandId().toString(), context.sha256());
+      if (!executor.compareAndSetM1TraceProgressReceiver(null, next.receiver)) {
+        throw new IOException("Another diagnostic receiver is already attached");
