+
+  private static final class Session {
+    final M1TraceCollector collector;
+    final SkyframeExecutor executor;
+    final FailureIsolatingReceiver receiver;
+    final Writer writer;
+    final Path output;
+    final String commandId;
+    final String contextSha256;
+
+    Session(
+        M1TraceCollector collector,
+        SkyframeExecutor executor,
+        Writer writer,
+        Path output,
+        String commandId,
+        String contextSha256) {
+      this.collector = collector;
+      this.executor = executor;
+      this.writer = writer;
+      this.output = output;
+      this.commandId = commandId;
+      this.contextSha256 = contextSha256;
+      receiver =
+          new FailureIsolatingReceiver(
+              collector,
+              failure -> {
+                collector.markIncomplete("observer_callback_exception");
+                logger.atWarning().withCause(failure).log(
+                    "M1 trace observer failed; subsequent callbacks disabled");
+              });
+    }
+  }
+
+  static Path canonicalFile(Path path) throws IOException {
+    if (!path.isAbsolute()
+        || !path.normalize().equals(path)
+        || path.getParent() == null
+        || !path.getParent().toRealPath().equals(path.getParent())) {
+      throw new IOException(
+          "Trace paths must be absolute, normalized and have an existing canonical parent");
+    }
+    return path;
+  }
+
+  static Writer openOutput(Path path) throws IOException {
+    return Files.newBufferedWriter(
+        canonicalFile(path),
+        StandardCharsets.UTF_8,
+        StandardOpenOption.CREATE_NEW,
+        StandardOpenOption.WRITE,
+        LinkOption.NOFOLLOW_LINKS);
+  }
+
+  static Path completionPath(Path output) {
+    return output.resolveSibling(output.getFileName() + ".completion.json");
+  }
+
+  static void writeCompletion(Path output, String commandId, String contextSha256)
+      throws IOException {
+    Map<String, Object> receipt = new LinkedHashMap<>();
+    receipt.put("schema_version", 1);
+    receipt.put("command_id", commandId);
+    receipt.put("context_sha256", contextSha256);
+    receipt.put("trace_path", output.toString());
+    receipt.put("completion", true);
+    byte[] bytes = (new Gson().toJson(receipt) + "\n").getBytes(StandardCharsets.UTF_8);
+    if (bytes.length > 4096) {
+      throw new IOException("Trace completion receipt exceeds 4 KiB");
+    }
+    Path completion = completionPath(output);
+    Path pending = output.resolveSibling(output.getFileName() + ".completion.pending-" + commandId);
+    // Publish only after this tiny receipt itself has closed successfully. Failed pending files
+    // remain evidence, but cannot satisfy the final receipt contract. Never overwrite either file.
+    try (var stream =
+        Files.newOutputStream(
+            pending,
+            StandardOpenOption.CREATE_NEW,
+            StandardOpenOption.WRITE,
+            LinkOption.NOFOLLOW_LINKS)) {
+      stream.write(bytes);
+    }
+    Files.move(pending, completion);
+  }
+
+  record Context(Map<String, Object> header, String sha256) {}
+
+  static Context readContext(Path path, String workspace) throws IOException {
+    canonicalFile(path);
+    if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) {
+      throw new IOException("Trace context must be a regular non-symlink file");
+    }
+    byte[] raw;
+    try (var input = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) {
+      raw = input.readNBytes(MAX_CONTEXT_BYTES + 1);
+    }
+    if (raw.length > MAX_CONTEXT_BYTES) {
+      throw new IOException("Trace context exceeds 64 KiB");
+    }
+    Map<String, Object> header;
+    try (JsonReader reader =
+        new JsonReader(
+            new StringReader(
+                StandardCharsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(raw)).toString()))) {
+      header = readObject(reader, 0);
+      if (reader.peek() != JsonToken.END_DOCUMENT || !header.keySet().equals(CONTEXT_FIELDS)) {
+        throw new IOException("Trace context has missing or unexpected fields");
+      }
+    }
+    validateContext(header, workspace);
+    try {
+      return new Context(
+          header, HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(raw)));
+    } catch (NoSuchAlgorithmException impossible) {
+      throw new IllegalStateException("SHA-256 unavailable", impossible);
+    }
+  }
+
+  private static Map<?, ?> object(Object value, Set<String> fields) throws IOException {
+    if (!(value instanceof Map<?, ?> map) || !map.keySet().equals(fields)) {
+      throw new IOException("Trace context has missing or unexpected nested fields");
+    }
+    return map;
+  }
+
+  private static void text(Object value) throws IOException {
+    if (!(value instanceof String string) || string.isEmpty() || string.length() > 256) {
+      throw new IOException("Trace context identity must be a nonempty bounded string");
+    }
+  }
+
+  private static void digest(Object value, int length) throws IOException {
+    if (!(value instanceof String string) || !string.matches("[0-9a-f]{" + length + "}")) {
+      throw new IOException("Trace context digest has an invalid form");
+    }
+  }
+
+  private static void validateContext(Map<String, Object> header, String workspace)
+      throws IOException {
+    for (String key : List.of("engine_id", "cohort_id", "semantic_epoch")) {
+      text(header.get(key));
+    }
+    for (String key : List.of("binary_sha256", "snapshot_id", "command_policy_sha256")) {
+      digest(header.get(key), 64);
+    }
+    if (!"private".equals(header.get("hosting"))
+        || !(header.get("phase") instanceof String phase)
+        || !Set.of("restart", "warm", "fixture").contains(phase)
+        || !(header.get("bzl_inlining") instanceof String inlining)
+        || !Set.of("enabled", "disabled", "unknown").contains(inlining)) {
+      throw new IOException("Trace context hosting, phase or Bzl mode differs from the contract");
+    }
+    Map<?, ?> source =
+        object(
+            header.get("source_identity"),
+            Set.of("base_commit", "patch_sha256", "reconstructed_git_tree"));
+    digest(source.get("base_commit"), 40);
+    digest(source.get("patch_sha256"), 64);
+    digest(source.get("reconstructed_git_tree"), 40);
+    Map<?, ?> bindings = object(header.get("repository_bindings"), Set.of("main"));
+    Map<?, ?> main =
+        object(
+            bindings.get("main"),
+            Set.of(
+                "logical_repository_id",
+                "physical_root",
+                "filesystem_policy",
+                "binding_provenance_sha256"));
+    text(main.get("logical_repository_id"));
+    digest(main.get("binding_provenance_sha256"), 64);
+    Map<?, ?> filesystem =
+        object(main.get("filesystem_policy"), Set.of("os", "case_sensitive", "digest_algorithm"));
+    text(filesystem.get("digest_algorithm"));
+    if (!workspace.equals(main.get("physical_root"))
+        || !"linux".equals(filesystem.get("os"))
+        || !Boolean.TRUE.equals(filesystem.get("case_sensitive"))) {
+      throw new IOException("Trace context must bind this Linux private workspace exactly");
+    }
+  }
+
+  private static Map<String, Object> readObject(JsonReader reader, int depth) throws IOException {
+    if (depth > 16) {
+      throw new IOException("Trace context nesting exceeds 16");
+    }
+    Map<String, Object> result = new LinkedHashMap<>();
+    reader.beginObject();
+    while (reader.hasNext()) {
+      String name = reader.nextName();
+      if (result.containsKey(name)) {
+        throw new IOException("Duplicate trace context key");
+      }
+      Object value =
+          switch (reader.peek()) {
+            case BEGIN_OBJECT -> readObject(reader, depth + 1);
+            case STRING -> reader.nextString();
+            case BOOLEAN -> reader.nextBoolean();
+            case NULL -> {
+              reader.nextNull();
+              yield null;
+            }
+            default ->
+                throw new IOException(
+                    "Trace context supports objects, strings, booleans and null only");
+          };
+      result.put(name, value);
+    }
+    reader.endObject();
+    return result;
+  }
+
+  /** Observer exceptions disable observation, without changing evaluator behavior. */
+  static final class FailureIsolatingReceiver implements EvaluationProgressReceiver {
+    private final EvaluationProgressReceiver delegate;
+    private final Consumer<RuntimeException> onFailure;
+    private final AtomicBoolean failed = new AtomicBoolean();
+
+    FailureIsolatingReceiver(
+        EvaluationProgressReceiver delegate, Consumer<RuntimeException> onFailure) {
+      this.delegate = delegate;
+      this.onFailure = onFailure;
+    }
+
+    boolean hasFailed() {
+      return failed.get();
+    }
+
+    private void observe(Runnable action) {
+      if (failed.get()) {
+        return;
+      }
+      try {
+        action.run();
+      } catch (RuntimeException failure) {
+        if (failed.compareAndSet(false, true)) {
+          try {
+            onFailure.accept(failure);
+          } catch (RuntimeException ignored) {
+            // Failure reporting is also observational.
+          }
+        }
+      }
+    }
+
+    @Override
+    public void dirtied(SkyKey key, DirtyType type) {
+      observe(() -> delegate.dirtied(key, type));
+    }
+
+    @Override
+    public void deleted(SkyKey key) {
+      observe(() -> delegate.deleted(key));
+    }
+
+    @Override
+    public void enqueueing(SkyKey key) {
+      observe(() -> delegate.enqueueing(key));
+    }
+
+    @Override
+    public void stateStarting(SkyKey key, NodeState state) {
+      observe(() -> delegate.stateStarting(key, state));
+    }
+
+    @Override
+    public void stateEnding(SkyKey key, NodeState state) {
+      observe(() -> delegate.stateEnding(key, state));
+    }
+
+    @Override
+    public void changePruned(SkyKey key) {
+      observe(() -> delegate.changePruned(key));
+    }
+
+    @Override
+    public void evaluated(
+        SkyKey key,
+        EvaluationState state,
+        @Nullable SkyValue value,
+        @Nullable ErrorInfo error,
+        @Nullable GroupedDeps deps) {
+      observe(() -> delegate.evaluated(key, state, value, error, deps));
+    }
+  }
+}
