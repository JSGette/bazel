+      byte[] keyBytes = key.toBytes();
+      byte[] digest = MessageDigest.getInstance("SHA-256").digest(keyBytes);
+      var charged = new java.util.concurrent.atomic.AtomicLong();
+      // If admission is late, the missing pack produces an I/O failure instead of this reason.
+      Files.delete(root.resolve(ID).resolve("data.pack"));
+      IOException failure =
+          assertThrows(
+              IOException.class,
+              () ->
+                  reader.getIfPresent(
+                      keyBytes,
+                      digest,
+                      false,
+                      bytes -> {
+                        charged.set(bytes);
+                        return false;
+                      }));
+      assertThat(failure).hasMessageThat().contains("restore allocation budget exhausted");
+      assertThat(charged.get()).isGreaterThan(1024 * 1024L);
+    }
+  }
