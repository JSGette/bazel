+  @Test
+  public void concurrentThreadsKeepIndependentStacks() throws Exception {
+    M1TraceCollector collector = new M1TraceCollector(output, root, () -> graph, header());
+    CountDownLatch started = new CountDownLatch(2);
+    try (var executor = Executors.newFixedThreadPool(2)) {
+      List<java.util.concurrent.Future<?>> futures = new ArrayList<>();
+      for (int i = 0; i < 2; i++) {
+        int index = i;
+        futures.add(
+            executor.submit(
+                () -> {
+                  collector.stateStarting(key("a" + index), NodeState.COMPUTE);
+                  started.countDown();
+                  try {
+                    started.await();
+                  } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    throw new AssertionError(e);
+                  }
+                  collector.stateEnding(key("a" + index), NodeState.COMPUTE);
+                }));
+      }
+      for (var future : futures) {
+        future.get();
+      }
+    }
+    collector.finish();
+    assertThat(
+            records("interval").stream()
+                .map(record -> record.get("thread_id").getAsLong())
+                .distinct()
+                .count())
+        .isEqualTo(2);
+    assertThat(footer().get("unbalanced_intervals").getAsInt()).isEqualTo(0);
+  }
