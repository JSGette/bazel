+      writer.publish(remoteManifest);
+      var gate = new ReadGate(backend.advertised);
+      backend.beforeRead = gate::beforeRead;
+      var session = new LocalCacheSession(destination, snapshot(), () -> 0L);
+      var bothLocalScans = new CountDownLatch(2);
+      var secondLocalScan = new CountDownLatch(1);
+      // Force both readers to finish the second local-only scan before remote admission completes.
+      // The second reader then reaches preparation with a stale miss, regardless of scheduling.
+      class AttemptedCandidates extends HashSet<String> {
+        private final boolean second;
+        private int localVisits;
+
+        AttemptedCandidates(boolean second) {
+          this.second = second;
+        }
+
+        @Override
+        public boolean add(String id) {
+          if (id.equals(localId) && ++localVisits == 2) {
+            bothLocalScans.countDown();
+            try {
+              assertThat(bothLocalScans.await(5, TimeUnit.SECONDS)).isTrue();
+              if (second) {
+                assertThat(gate.entered.await(5, TimeUnit.SECONDS)).isTrue();
+                secondLocalScan.countDown();
+              }
+            } catch (InterruptedException e) {
+              Thread.currentThread().interrupt();
+              throw new AssertionError(e);
+            }
+          }
+          return super.add(id);
+        }
+      }
+      try {
+        assertThat(session.get(local).get()).isEqualTo(new byte[] {1});
+        session.setRemote(reader);
+        var first =
+            pool.submit(
+                () -> session.nextAnalysisCandidate(requested, new AttemptedCandidates(false)));
+        var second =
+            pool.submit(
+                () -> session.nextAnalysisCandidate(requested, new AttemptedCandidates(true)));
+        assertThat(secondLocalScan.await(5, TimeUnit.SECONDS)).isTrue();
+        gate.release.countDown();
+        assertThat(first.get(5, TimeUnit.SECONDS).value()).isEqualTo(new byte[] {2});
+        assertThat(second.get(5, TimeUnit.SECONDS).value()).isEqualTo(new byte[] {2});
+        assertThat(backend.discoveryRequests.get()).isEqualTo(1);
+      } finally {
+        gate.release.countDown();
+        pool.shutdownNow();
+        assertThat(pool.awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+        session.finish(false);
+      }
+    } finally {
+      pool.shutdownNow();
+    }
+  }
