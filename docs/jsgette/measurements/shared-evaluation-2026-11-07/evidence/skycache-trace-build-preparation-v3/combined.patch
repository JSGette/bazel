+  private final Writer writer;
+  private final Root workspaceRoot;
+  private final Supplier<InMemoryGraph> graphSupplier;
+  @Nullable private InMemoryGraph boundGraph;
+  private final Limits limits;
+  private final Clock clock;
+  private final long wallOrigin;
+  private final Gson gson = new GsonBuilder().serializeNulls().disableHtmlEscaping().create();
+  private final MessageDigest digest;
+  private final Map<SkyKey, Integer> nodes = new HashMap<>();
+  private final Set<Integer> observed = new HashSet<>();
+  private final Set<Integer> retained = new HashSet<>();
+  private final Map<Thread, ThreadState> threads = new IdentityHashMap<>();
+  private final Map<String, Long> occurrences = new HashMap<>();
+  private final Map<String, Long> counts = new LinkedHashMap<>();
+  private final Map<String, Long> unknown = new LinkedHashMap<>();
+  private final Set<String> exceeded = new LinkedHashSet<>();
+  private final String digestAlgorithm;
+  private long sequence;
+  private long observationSequence;
+  private long intervalSequence;
+  private long outputBytes;
+  private long projectedBytes;
+  private long edgeCount;
