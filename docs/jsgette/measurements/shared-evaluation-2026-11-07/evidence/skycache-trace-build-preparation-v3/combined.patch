+  @Test
+  public void manySealedReadersKeepNoPackDescriptors() throws Exception {
+    Path root = temporary.newFolder().toPath();
+    var key = new Key("bounded-descriptors");
+    try (var writer = PackedFingerprintValueStore.create(root, ID)) {
+      writer.put(key, new byte[] {7}).get();
+      writer.seal();
+      var readers = new ArrayList<PackedFingerprintValueStore>();
+      try {
+        for (int i = 0; i < 128; i++) {
+          var reader = PackedFingerprintValueStore.open(root, ID);
+          readers.add(reader);
+          assertThat(reader.get(key).get()).isEqualTo(new byte[] {7});
+        }
+        Path pack = root.resolve(ID).resolve("data.pack").toRealPath();
+        try (var descriptors = Files.list(Path.of("/proc/self/fd"))) {
+          assertThat(
+                  descriptors
+                      .filter(
+                          path -> {
+                            try {
+                              return Files.readSymbolicLink(path).equals(pack);
+                            } catch (IOException e) {
+                              return false;
+                            }
+                          })
+                      .count())
+              .isEqualTo(0);
+        }
+      } finally {
+        for (var reader : readers) {
+          reader.close();
+        }
+      }
+      // Sealing also releases writer channels while retaining read-your-writes.
+      assertThat(writer.get(key).get()).isEqualTo(new byte[] {7});
+    }
+  }
