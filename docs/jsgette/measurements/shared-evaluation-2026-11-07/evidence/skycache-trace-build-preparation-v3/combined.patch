+    Path localManifest = publishLocal(destination, local, new byte[] {1});
+    String localId = localManifest.getFileName().toString().replaceFirst("\\.manifest$", "");
+    Path remoteManifest = publishLocal(source, requested, new byte[] {2});
+    var pool = Executors.newFixedThreadPool(2);
+    try (var backend = new MemoryRemote();
+        var writer = remote(source, backend);
