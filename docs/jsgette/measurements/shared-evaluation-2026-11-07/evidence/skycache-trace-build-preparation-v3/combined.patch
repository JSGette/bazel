+    @Override
+    public void serialize(SerializationContext context, NonSkyValue value, CodedOutputStream out)
+        throws IOException, SerializationException {
+      if (shared) {
+        context.putSharedValue(value, null, new NonSkyValueCodec(false), out);
+      } else {
+        out.writeStringNoTag(value.text());
+      }
+    }
