+    String text = output.toString();
+    String prefix = text.substring(0, text.lastIndexOf("{\"type\":\"footer\""));
+    String expected =
+        HexFormat.of()
+            .formatHex(
+                MessageDigest.getInstance("SHA-256")
+                    .digest(prefix.getBytes(StandardCharsets.UTF_8)));
+    assertThat(footer().get("preceding_bytes_sha256").getAsString()).isEqualTo(expected);
+    assertThat(footer().getAsJsonObject("record_counts").get("footer").getAsInt()).isEqualTo(0);
+    assertThat(footer().getAsJsonObject("record_counts").get("node").getAsInt()).isEqualTo(1);
