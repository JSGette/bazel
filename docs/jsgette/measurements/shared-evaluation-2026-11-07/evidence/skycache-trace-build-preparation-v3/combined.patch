+/** Cheap exclusions before an analysis root starts asynchronous serialization. */
+final class LocalAnalysisValues {
+  private LocalAnalysisValues() {}
+
+  static boolean shouldUpload(SkyValue value) {
+    try {
+      var seen = new IdentityHashMap<Object, Boolean>();
+      if (value instanceof ConfiguredTargetValue configured) {
+        checkTarget(configured.getConfiguredTarget(), seen, 0);
+      } else if (value instanceof AspectValue aspect) {
+        checkProviderMap(aspect.getProviders(), seen, 0);
+      }
+      return true;
+    } catch (SerializationException e) {
+      return false;
+    }
+  }
+
+  private static void checkTarget(
+      ConfiguredTarget target, IdentityHashMap<Object, Boolean> seen, int depth)
+      throws SerializationException {
+    // getActual follows aliases. Rules expose their stored providers without creating query
+    // dictionaries, stringifying provider keys or synthesizing native DefaultInfo.
+    target = target.getActual();
+    if (depth > 128 || seen.size() >= 100_000) {
+      throw new SerializationException("configured target admission traversal limit");
+    }
+    if (seen.putIfAbsent(target, true) != null) {
+      return;
+    }
+    if (target instanceof RuleConfiguredTarget rule) {
+      checkProviderMap(rule.getProvidersForMetrics(), seen, depth + 1);
+    } else {
+      if (target instanceof MergedConfiguredTarget merged) {
+        // The merged query view contains only aspect providers, so inspect its base separately.
+        checkTarget(merged.getBaseConfiguredTarget(), seen, depth + 1);
+      }
+      checkVisibleProviders(target.getProvidersDictForQuery(), seen, depth + 1);
+    }
+  }
+
+  private static void checkProviderMap(
+      TransitiveInfoProviderMap providers, IdentityHashMap<Object, Boolean> seen, int depth)
+      throws SerializationException {
+    for (int i = 0; i < providers.getProviderCount(); i++) {
+      checkVisibleProviders(providers.getProviderInstanceAt(i), seen, depth);
+    }
+  }
+
+  private static void checkVisibleProviders(
+      Object value, IdentityHashMap<Object, Boolean> seen, int depth)
+      throws SerializationException {
+    if (!(value instanceof StarlarkInfo
+        || value instanceof ToolchainInfo
+        || value instanceof List<?>
+        || value instanceof Map<?, ?>)) {
+      // Apart from the explicit ToolchainInfo carrier, native providers and other opaque values
+      // are not traversed here. Hidden unsafe providers still discard the publication at the codec.
+      return;
+    }
+    if (depth > 128 || seen.size() >= 100_000) {
+      throw new SerializationException("provider admission traversal limit");
+    }
+    Boolean complete = seen.putIfAbsent(value, false);
+    if (complete != null) {
+      if (complete) {
+        return;
+      }
+      throw new SerializationException("cyclic provider container");
+    }
+    switch (value) {
+      case StarlarkInfo info -> LocalStarlarkInfoCodec.checkEligible(info);
+      case ToolchainInfo toolchain -> {
+        // This final class exposes its complete stored field map through these public accessors.
+        // Inspect the carrier without reflecting over native graphs or expanding nested sets.
+        for (String field : toolchain.getFieldNames()) {
+          Object fieldValue;
+          try {
+            fieldValue = toolchain.getValue(field);
+          } catch (EvalException e) {
+            // The current accessor only reads an immutable map. An unexpected accessor failure
+            // must retain the global upload failure policy, not become a benign exclusion.
+            throw new IllegalStateException("could not inspect ToolchainInfo field " + field, e);
+          }
+          checkVisibleProviders(fieldValue, seen, depth + 1);
+        }
+      }
+      case List<?> list -> {
+        for (Object element : list) {
+          checkVisibleProviders(element, seen, depth + 1);
+        }
+      }
+      case Map<?, ?> map -> {
+        for (var entry : map.entrySet()) {
+          checkVisibleProviders(entry.getKey(), seen, depth + 1);
+          checkVisibleProviders(entry.getValue(), seen, depth + 1);
+        }
+      }
+      default -> throw new AssertionError(value);
+    }
+    seen.put(value, true);
+  }
+}
