+/** Bounded command-local observations. It does not authorize cache reuse or change evaluation. */
+public final class M1TraceCollector implements EvaluationProgressReceiver, AutoCloseable {
+  private static final FileStateValue NONEXISTENT_FILE_STATE_VALUE =
+      FileStateValue.NONEXISTENT_FILE_STATE_NODE;
+
+  static final int MAX_RECORD_BYTES = 1024 * 1024;
+  static final int FOOTER_RESERVE = 65536;
+  static final int MAX_THREADS = 256;
+  static final int MAX_STACK_DEPTH = 128;
+  static final long MAX_INTERVALS = 1000000;
+  static final long MAX_OBSERVATIONS = 1000000;
+  static final long MAX_RECORDS = 1000000;
+  static final Limits DEFAULT_LIMITS =
+      new Limits(250000, 2000000, 64L * 1024 * 1024, 256L * 1024 * 1024, 65536);
+
+  record Limits(
+      int nodes, long edges, long projectedBytes, long outputBytes, int projectionBytes) {}
+
+  interface Clock {
+    long wall();
+
+    long cpu();
+
+    boolean virtual();
+  }
+
+  private static final class CpuClock implements Clock {
+    private final ThreadMXBean bean = ManagementFactory.getThreadMXBean();
+
+    @Override
+    public long wall() {
+      return System.nanoTime();
+    }
+
+    @Override
+    public boolean virtual() {
+      return Thread.currentThread().isVirtual();
+    }
+
+    @Override
+    public long cpu() {
+      return !virtual() && bean.isCurrentThreadCpuTimeSupported() && bean.isThreadCpuTimeEnabled()
+          ? bean.getCurrentThreadCpuTime()
+          : -1;
+    }
+  }
