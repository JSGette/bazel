+    final boolean virtual;
+    long childCpu;
+    boolean unknownChild;
+
+    Frame(
+        long id,
+        Long parent,
+        int node,
+        NodeState state,
+        long occurrence,
+        long wall,
+        long cpu,
+        boolean virtual) {
+      this.id = id;
+      this.parent = parent;
+      this.node = node;
+      this.state = state;
+      this.occurrence = occurrence;
+      this.wall = wall;
+      this.cpu = cpu;
+      this.virtual = virtual;
+    }
+  }
+
+  private static final class ThreadState {
+    final long id;
+    final ArrayDeque<Frame> stack = new ArrayDeque<>();
