+  private static void renamePublications(Path cache, Map<String, String> replacements)
+      throws Exception {
+    Path manifests = cache.resolve("leased-v2/publications-v4");
+    try (var paths = Files.walk(manifests)) {
+      for (Path path : paths.filter(p -> p.toString().endsWith(".manifest")).toList()) {
+        byte[] bytes = Files.readAllBytes(path);
+        String payload =
+            new String(bytes, 0, bytes.length - 32, java.nio.charset.StandardCharsets.ISO_8859_1);
+        for (var replacement : replacements.entrySet()) {
+          payload = payload.replace(replacement.getKey(), replacement.getValue());
+        }
+        byte[] encoded = payload.getBytes(java.nio.charset.StandardCharsets.ISO_8859_1);
+        byte[] checksum = java.security.MessageDigest.getInstance("SHA-256").digest(encoded);
+        Files.write(
+            path, ByteBuffer.allocate(encoded.length + 32).put(encoded).put(checksum).array());
+        String oldId = path.getFileName().toString().substring(0, 64);
+        Files.move(path, path.resolveSibling(replacements.get(oldId) + ".manifest"));
+      }
+    }
+    Path objects = cache.resolve("leased-v2/objects/segmented-v1");
+    for (var replacement : replacements.entrySet()) {
+      Files.move(objects.resolve(replacement.getKey()), objects.resolve(replacement.getValue()));
+    }
+  }
