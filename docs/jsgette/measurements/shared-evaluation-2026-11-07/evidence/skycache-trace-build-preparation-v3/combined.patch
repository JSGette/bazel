+  @Test
+  public void scalarProviderPreservesIndependentAndMixedUnionEquality() throws Exception {
+    var shared = StarlarkInfo.create(StructProvider.STRUCT, ImmutableMap.of("label", "shared"));
+    var first = decode(encode(codecs, shared));
+    var second = decode(encode(codecs, shared));
+    assertThat(NestedSetBuilder.<StarlarkInfo>stableOrder().add(first).add(second).build().toList())
+        .containsExactly(shared);
+    assertThat(NestedSetBuilder.<StarlarkInfo>stableOrder().add(shared).add(first).build().toList())
+        .containsExactly(shared);
+    assertThat(decode(encode(codecs, first))).isEqualTo(shared);
+  }
+
+  @Test
+  public void unsafeProvidersAreExcludedBeforeIndependentOrMixedRestoration() {
+    var first = unsafeProvider();
+    var second = unsafeProvider();
+    assertThat(first).isNotEqualTo(second);
+    assertThrows(SerializationException.class, () -> encode(codecs, first));
+    assertThrows(SerializationException.class, () -> encode(codecs, second));
+    // The same policy applies before a provider has been placed in any depset.
+    assertThrows(SerializationException.class, () -> LocalStarlarkInfoCodec.checkEligible(first));
+  }
+
+  @Test
+  public void nestedContainerCannotHideUnsafeProviderOrDepset() {
+    var nested =
+        StarlarkInfo.create(
+            StructProvider.STRUCT,
