+public final class LocalStarlarkInfoCodecTest {
+  private final CompressionServiceImpl compression = new CompressionServiceImpl();
+  private final InMemoryFingerprintValueStore store = new InMemoryFingerprintValueStore();
+  private final FingerprintValueService writer = FingerprintValueService.createForTesting(store);
+  private final FingerprintValueService reader = FingerprintValueService.createForTesting(store);
+  private final ObjectCodecs codecs = codecs(new LocalStarlarkInfoCodec());
+
+  private static ObjectCodecs codecs(DeferredObjectCodec<StarlarkInfo> codec) {
+    return new ObjectCodecs(
+        AutoRegistry.get()
+            .getBuilder()
+            .add(codec)
+            .addReferenceConstant(StructProvider.STRUCT)
+            .build());
+  }
+
+  private ByteString encode(ObjectCodecs encoder, Object value) throws Exception {
+    var result = encoder.serializeMemoizedAndBlocking(compression, writer, value);
+    if (result.getFutureToBlockWritesOn() != null) {
+      var unused = result.getFutureToBlockWritesOn().get();
+    }
+    return result.getObject();
+  }
+
+  private StarlarkInfo decode(ByteString bytes) throws Exception {
+    return (StarlarkInfo) codecs.deserializeMemoizedAndBlocking(compression, reader, bytes);
+  }
+
+  private static StarlarkInfo unsafeProvider() {
+    return StarlarkInfo.create(
+        StructProvider.STRUCT,
+        ImmutableMap.of(
+            "label",
+            "shared",
+            "deps",
+            Depset.of(String.class, NestedSetBuilder.<String>stableOrder().add("lib.a").build())));
+  }
