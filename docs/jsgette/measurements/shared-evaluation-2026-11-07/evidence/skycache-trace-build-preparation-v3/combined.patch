+
+  public M1TraceCollector(
+      Writer writer,
+      Root workspaceRoot,
+      Supplier<InMemoryGraph> graph,
+      Map<String, Object> header) {
+    this(writer, workspaceRoot, graph, header, DEFAULT_LIMITS, new CpuClock());
+  }
+
+  M1TraceCollector(
+      Writer writer,
+      Root workspaceRoot,
+      Supplier<InMemoryGraph> graph,
+      Map<String, Object> header,
+      Limits limits,
+      Clock clock) {
+    this.writer = writer;
+    this.workspaceRoot = workspaceRoot;
+    this.graphSupplier = graph;
+    this.limits = limits;
+    this.clock = clock;
+    this.wallOrigin = clock.wall();
+    try {
+      digest = MessageDigest.getInstance("SHA-256");
+    } catch (NoSuchAlgorithmException e) {
+      throw new AssertionError(e); // Required by the Java runtime.
+    }
+    digestAlgorithm = workspaceRoot.getFileSystem().getDigestFunction().toString();
+    for (String type :
+        List.of("header", "node", "event", "observation", "bzl_input", "interval", "footer")) {
+      counts.put(type, 0L);
+    }
+    guarded(
+        () -> {
+          Map<String, Object> record = new LinkedHashMap<>(header);
+          record.put("type", "header");
+          record.put("format", "m1-typed-trace-v1");
+          record.put(
+              "limits",
+              row(
+                  "max_nodes",
+                  limits.nodes(),
+                  "max_edges",
+                  limits.edges(),
+                  "max_projected_bytes",
+                  limits.projectedBytes(),
+                  "max_total_bytes",
+                  limits.outputBytes(),
+                  "max_record_bytes",
+                  MAX_RECORD_BYTES,
+                  "max_projection_bytes",
+                  limits.projectionBytes(),
+                  "max_pending_bytes",
+                  MAX_RECORD_BYTES,
+                  "reserved_footer_bytes",
+                  FOOTER_RESERVE,
+                  "max_threads",
+                  MAX_THREADS,
+                  "max_stack_depth",
+                  MAX_STACK_DEPTH,
+                  "max_intervals",
+                  MAX_INTERVALS,
+                  "max_observations",
+                  MAX_OBSERVATIONS,
+                  "max_records",
+                  MAX_RECORDS));
+          ThreadMXBean bean = ManagementFactory.getThreadMXBean();
+          record.put(
+              "cpu_capability",
+              row(
+                  "current_thread_supported",
+                  bean.isCurrentThreadCpuTimeSupported(),
+                  "enabled",
+                  bean.isThreadCpuTimeEnabled(),
+                  "virtual_thread_supported",
+                  false));
+          record.put("actual_digest_algorithm", digestAlgorithm);
+          for (String field :
+              List.of(
+                  "trace_id",
+                  "command_id",
+                  "engine_id",
+                  "cohort_id",
+                  "phase",
+                  "hosting",
+                  "binary_sha256",
+                  "source_identity",
+                  "semantic_epoch",
+                  "snapshot_id",
+                  "command_policy_sha256",
+                  "repository_bindings",
+                  "bzl_inlining",
+                  "context_sha256",
+                  "context_status",
+                  "capture_window",
+                  "direct_skycache_witness_validation")) {
+            if (!header.containsKey(field) || header.get(field) == null) {
+              markIncomplete("missing_header_" + field);
+            }
+          }
+          emit(record, false);
+        });
+  }
+
+  private static Map<String, Object> row(Object... fields) {
+    Map<String, Object> out = new LinkedHashMap<>();
+    for (int i = 0; i < fields.length; i += 2) {
+      out.put((String) fields[i], fields[i + 1]);
+    }
+    return out;
+  }
+
+  private void guarded(Runnable action) {
+    if (finished || stopped) {
+      return;
+    }
+    try {
+      action.run();
+    } catch (RuntimeException e) {
+      markIncomplete("observer_" + e.getClass().getSimpleName());
+    }
+  }
+
+  public synchronized void markIncomplete(String reason) {
+    complete = false;
+    countUnknown(reason);
+  }
+
+  private void countUnknown(String reason) {
+    String bounded = reason.length() > 128 ? reason.substring(0, 128) : reason;
+    if (unknown.size() >= 64 && !unknown.containsKey(bounded)) {
+      bounded = "other";
+    }
+    unknown.merge(bounded, 1L, Long::sum);
+  }
+
+  private void overflow(String limit) {
+    exceeded.add(limit);
+    complete = false;
+    stopped = true;
+  }
+
+  private void emit(Map<String, Object> record, boolean footer) {
+    if ((!footer && stopped) || writerError != null) {
+      return;
+    }
+    if (!footer && sequence >= MAX_RECORDS - 1) {
+      overflow("max_records");
+      return;
+    }
+    record.put("seq", sequence);
+    String text = gson.toJson(record) + "\n";
+    byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+    if (bytes.length > (footer ? FOOTER_RESERVE : MAX_RECORD_BYTES)) {
+      overflow("max_record_bytes");
+      return;
+    }
+    if (outputBytes + bytes.length + (footer ? 0 : FOOTER_RESERVE) > limits.outputBytes()) {
+      overflow("max_total_bytes");
+      return;
+    }
+    try {
+      writer.write(text);
+      outputBytes += bytes.length;
+      sequence++;
+      if (!footer) {
+        digest.update(bytes);
+        counts.merge((String) record.get("type"), 1L, Long::sum);
+      }
+    } catch (IOException e) {
+      writerError = e.getClass().getSimpleName();
+      complete = false;
+      stopped = true;
+    }
+  }
+
+  private InMemoryGraph graph() {
+    InMemoryGraph current = graphSupplier.get();
+    if (current == null) {
+      throw new IllegalStateException("missing_evaluator_graph");
+    }
+    if (boundGraph == null) {
+      boundGraph = current;
+    } else if (boundGraph != current) {
+      markIncomplete("evaluator_graph_replaced");
+      stopped = true;
+      throw new IllegalStateException("evaluator_graph_replaced");
+    }
+    return current;
+  }
+
+  private int node(SkyKey key) {
+    if (stopped) {
+      return 0;
+    }
+    graph();
+    Integer existing = nodes.get(key);
+    if (existing != null) {
+      return existing;
+    }
+    if (nodes.size() >= limits.nodes()) {
+      overflow("max_nodes");
+      return 0;
+    }
+    int id = nodes.size() + 1;
+    nodes.put(key, id);
+    RootedPath path = supportedPath(key);
+    if (path != null
+        && (long) path.getRootRelativePath().getPathString().length() * 4 > MAX_RECORD_BYTES / 2) {
+      overflow("max_record_bytes");
+      return 0;
+    }
+    emit(
+        row(
+            "type",
+            "node",
+            "node_id",
+            id,
+            "function",
+            key.functionName().getName(),
+            "logical_key",
+            path == null
+                ? null
+                : List.of("main", utf16(path.getRootRelativePath().getPathString())),
+            "key_status",
+            path == null ? "unsupported" : "supported",
+            "reason",
+            path == null ? "unsupported_function_or_root" : null),
+        false);
+    return id;
+  }
+
+  @Nullable
+  private RootedPath supportedPath(SkyKey key) {
+    if (!(key.functionName().equals(FileStateKey.FILE_STATE)
+        || key.functionName().equals(SkyFunctions.DIRECTORY_LISTING_STATE))) {
+      return null;
+    }
+    if (!(key.argument() instanceof RootedPath path) || !path.getRoot().equals(workspaceRoot)) {
+      return null;
+    }
+    return path;
+  }
+
+  static String utf16(String value) {
+    StringBuilder out = new StringBuilder(value.length() * 4);
+    for (int i = 0; i < value.length(); i++) {
+      int c = value.charAt(i);
+      out.append(Character.forDigit(c >>> 12, 16))
+          .append(Character.forDigit((c >>> 8) & 15, 16))
+          .append(Character.forDigit((c >>> 4) & 15, 16))
+          .append(Character.forDigit(c & 15, 16));
+    }
+    return out.toString();
+  }
+
+  @Nullable
+  private Map<String, Object> projection(SkyKey key, @Nullable SkyValue value) {
+    if (supportedPath(key) == null || value == null) {
+      return null;
+    }
+    if (key.functionName().equals(FileStateKey.FILE_STATE) && !(value instanceof FileStateValue)
+        || key.functionName().equals(SkyFunctions.DIRECTORY_LISTING_STATE)
+            && !(value instanceof DirectoryListingStateValue)) {
+      return null;
+    }
+    Map<String, Object> out;
+    if (value instanceof FileStateValue.RegularFileStateValueWithDigest file) {
+      if ((long) file.getDigest().length * 2 + 256 > limits.projectionBytes()) {
+        overflow("max_projection_bytes");
+        return null;
+      }
+      out =
+          row(
+              "class",
+              "RegularFileStateValueWithDigest",
+              "type",
+              "REGULAR_FILE",
+              "size",
+              file.getSize(),
+              "digest_algorithm",
+              digestAlgorithm,
+              "digest_hex",
+              HexFormat.of().formatHex(file.getDigest()));
+    } else if (value instanceof FileStateValue.DirectoryFileStateValue) {
+      out = row("class", "DirectoryFileStateValue", "type", "DIRECTORY");
+    } else if (NONEXISTENT_FILE_STATE_VALUE.equals(value)) {
+      out = row("class", "NonexistentFileStateValue", "type", "NONEXISTENT");
+    } else if (value instanceof FileStateValue.SymlinkFileStateValue link) {
+      String target = link.getSymlinkTarget().getPathString();
+      if ((long) target.length() * 4 > limits.projectionBytes()) {
+        overflow("max_projection_bytes");
+        return null;
+      }
+      out =
+          row(
+              "class",
+              "SymlinkFileStateValue",
+              "type",
+              "SYMLINK",
+              "target_utf16be_hex",
+              utf16(target));
+    } else if (value instanceof DirectoryListingStateValue listing) {
+      List<List<String>> entries = new ArrayList<>();
+      long estimate = 128;
+      for (Dirent entry : listing.getDirents()) {
+        estimate += (long) entry.getName().length() * 4 + 32;
+        if (estimate > limits.projectionBytes()) {
+          overflow("max_projection_bytes");
+          return null;
+        }
+        entries.add(List.of(utf16(entry.getName()), entry.getType().name()));
+      }
+      entries.sort(Comparator.comparing(entry -> entry.get(0)));
+      out =
+          row(
+              "class",
+              "DirectoryListingStateValue",
+              "type",
+              "DIRECTORY_LISTING_STATE",
+              "entries",
+              entries);
+    } else {
+      return null;
+    }
+    int bytes = gson.toJson(out).getBytes(StandardCharsets.UTF_8).length;
+    if (bytes > limits.projectionBytes()) {
+      overflow("max_projection_bytes");
+      return null;
+    }
+    if (projectedBytes + bytes > limits.projectedBytes()) {
+      overflow("max_projected_bytes");
+      return null;
+    }
+    projectedBytes += bytes;
+    return out;
+  }
+
+  @Nullable
+  private GroupedDeps deps(@Nullable InMemoryNodeEntry entry) {
+    if (stopped || entry == null || !entry.isDone() || !entry.keepsEdges()) {
+      return null;
+    }
+    Object compressed = entry.getCompressedDirectDepsForDoneEntry();
+    int size = GroupedDeps.numElements(GroupedDeps.castAsCompressed(compressed));
+    if (!dependencyBudget(size)) {
+      return null;
+    }
+    return GroupedDeps.decompress(GroupedDeps.castAsCompressed(compressed));
+  }
+
+  private boolean dependencyBudget(int size) {
+    if (size > MAX_RECORD_BYTES / 32) {
+      overflow("max_record_bytes");
+      return false;
+    }
+    if (edgeCount + size > limits.edges()) {
+      overflow("max_edges");
+      return false;
+    }
+    return !stopped;
+  }
+
+  private long reserveObservation() {
+    if (observationSequence >= MAX_OBSERVATIONS) {
+      overflow("max_observations");
+      return 0;
+    }
+    return ++observationSequence;
+  }
+
+  private long observe(
+      SkyKey key,
+      @Nullable SkyValue value,
+      @Nullable GroupedDeps dependencies,
+      String origin,
+      String depsOrigin,
+      boolean error,
+      @Nullable Map<SkyKey, Long> finalIds,
+      @Nullable Long reservedId) {
+    if (stopped) {
+      return 0;
+    }
+    int id = node(key);
+    if (id == 0 || stopped) {
+      return 0;
+    }
+    long observation = reservedId == null ? reserveObservation() : reservedId;
+    if (observation == 0) {
+      return 0;
+    }
+    Map<String, Object> projected = projection(key, value);
+    if (stopped) {
+      return 0;
+    }
+    String status =
+        error
+            ? "error"
+            : value == null
+                ? "unavailable"
+                : projected == null ? "unsupported" : "exact_projection";
+    String reason =
+        status.equals("exact_projection")
+            ? null
+            : error
+                ? "evaluation_error"
+                : value == null
+                    ? "value_unavailable"
+                    : "unsupported_value_" + value.getClass().getSimpleName();
+    if (reason != null) {
+      countUnknown(reason);
+    }
+    List<List<List<Object>>> groups = null;
+    if (dependencies == null) {
+      countUnknown("dependencies_unavailable");
+    }
+    if (dependencies != null) {
+      if (!dependencyBudget(dependencies.numElements())) {
+        return 0;
+      }
+      groups = new ArrayList<>();
+      for (List<SkyKey> group : dependencies) {
+        List<List<Object>> groupRows = new ArrayList<>();
+        for (SkyKey dependency : group) {
+          int dependencyId = node(dependency);
+          if (dependencyId == 0 || stopped) {
+            return 0;
+          }
+          Long dependencyObservation = finalIds == null ? null : finalIds.get(dependency);
+          List<Object> edge = new ArrayList<>(2);
+          edge.add(dependencyId);
+          edge.add(dependencyObservation);
+          groupRows.add(edge);
+        }
+        groups.add(groupRows);
+      }
+      edgeCount += dependencies.numElements();
+    }
+    emit(
+        row(
+            "type",
+            "observation",
+            "observation_id",
+            observation,
+            "node_id",
+            id,
+            "origin",
+            origin,
+            "value_status",
+            status,
+            "projection",
+            error ? null : projected,
+            "reason",
+            reason,
+            "deps_status",
+            dependencies == null ? "unavailable" : "grouped",
+            "deps_origin",
+            dependencies == null ? "unavailable" : depsOrigin,
+            "groups",
+            groups,
+            "dependency_read_contract",
+            "captured_state_only"),
+        false);
+    if (stopped) {
+      return 0;
+    }
+    if (origin.equals("retained_done")) {
+      retained.add(id);
+    }
+    if (key instanceof BzlLoadValue.Key bzl && value instanceof BzlLoadValue loaded) {
+      bzlInput(id, observation, bzl, loaded);
+    }
+    return observation;
+  }
+
+  private void bzlInput(int node, long observation, BzlLoadValue.Key key, BzlLoadValue value) {
+    long size = (long) value.getTransitiveDigest().length * 2 + 1024;
+    size +=
+        4L
+            * (key.getLabel().getRepository().getName().length()
+                + key.getLabel().getPackageName().length()
+                + key.getLabel().getName().length());
+    if (size > MAX_RECORD_BYTES) {
+      overflow("max_record_bytes");
+      return;
+    }
+    String variant =
+        key instanceof BzlLoadValue.KeyForBuild
+            ? "build"
+            : key instanceof BzlLoadValue.KeyForBuiltins
+                ? "builtins"
+                : key instanceof BzlLoadValue.KeyForBzlmodBootstrap
+                    ? "bzlmod_bootstrap"
+                    : key instanceof BzlLoadValue.KeyForBzlmod ? "bzlmod" : "unknown";
+    emit(
+        row(
+            "type",
+            "bzl_input",
+            "node_id",
+            node,
+            "observation_id",
+            observation,
+            "key_variant",
+            variant,
+            "label_parts_utf16be_hex",
+            List.of(
+                utf16(key.getLabel().getRepository().getName()),
+                utf16(key.getLabel().getPackageName()),
+                utf16(key.getLabel().getName())),
+            "build_prelude",
+            key.isBuildPrelude(),
+            "builtins",
+            key.isBuiltins(),
+            "scl_dialect",
+            key.isSclDialect(),
+            "semantics_binding",
+            null,
+            "repository_mapping_binding",
+            null,
+            "transitive_digest_hex",
+            HexFormat.of().formatHex(value.getTransitiveDigest()),
+            "status",
+            "input_evidence_only",
+            "reason",
+            "semantics_and_mapping_not_projected"),
+        false);
+  }
+
+  private void event(SkyKey key, String event, @Nullable DirtyType dirtyType) {
+    int id = node(key);
+    if (id == 0 || stopped) {
+      return;
+    }
+    observed.add(id);
+    emit(
+        row(
+            "type",
+            "event",
+            "node_id",
+            id,
+            "event",
+            event,
+            "evaluation_state",
+            null,
+            "new_value_supplied",
+            null,
+            "new_error_supplied",
+            null,
+            "direct_deps_supplied",
+            null,
+            "dirty_type",
+            dirtyType == null ? null : dirtyType.name(),
+            "observation_id",
+            null),
+        false);
+  }
+
+  @Override
+  public synchronized void dirtied(SkyKey key, DirtyType type) {
+    guarded(() -> event(key, "dirtied", type));
+  }
+
+  @Override
+  public synchronized void deleted(SkyKey key) {
+    guarded(() -> event(key, "deleted", null));
+  }
+
+  @Override
+  public synchronized void enqueueing(SkyKey key) {
+    guarded(() -> event(key, "enqueueing", null));
+  }
+
+  @Override
+  public synchronized void changePruned(SkyKey key) {
+    guarded(() -> event(key, "change_pruned", null));
+  }
+
+  @Override
+  public synchronized void evaluated(
+      SkyKey key,
+      EvaluationState state,
+      @Nullable SkyValue value,
+      @Nullable ErrorInfo error,
+      @Nullable GroupedDeps directDeps) {
+    guarded(
+        () -> {
+          int id = node(key);
+          if (id == 0 || stopped) {
+            return;
+          }
+          observed.add(id);
+          InMemoryNodeEntry entry = graph().getIfPresent(key);
+          GroupedDeps actual = directDeps != null ? directDeps : deps(entry);
+          // Bind only fresh, currently-done captures; earlier observations never fill missing
+          // edges.
+          Map<SkyKey, Long> captures = new HashMap<>();
+          if (actual != null && !dependencyBudget(actual.numElements())) {
+            return;
+          }
+          // Capture actual state dependencies before the executor's heuristic child removal.
+          if (actual != null) {
+            for (List<SkyKey> group : actual) {
+              for (SkyKey child : group) {
+                if (stopped) {
+                  return;
+                }
+                if (supportedPath(child) == null) {
+                  continue;
+                }
+                InMemoryNodeEntry childEntry = graph().getIfPresent(child);
+                if (childEntry != null && childEntry.isDone()) {
+                  long capture =
+                      observe(
+                          child,
+                          childEntry.getValue(),
+                          deps(childEntry),
+                          "before_child_drop",
+                          "retained_done",
+                          childEntry.getErrorInfo() != null,
+                          null,
+                          null);
+                  if (stopped) {
+                    return;
+                  }
+                  if (capture != 0) {
+                    captures.put(child, capture);
+                  }
+                }
+              }
+            }
+          }
+          SkyValue current =
+              value != null ? value : entry != null && entry.isDone() ? entry.getValue() : null;
+          long observation =
+              observe(
+                  key,
+                  current,
+                  actual,
+                  value != null ? "evaluated_value" : "evaluated_current",
+                  directDeps != null ? "evaluated_direct_deps" : "retained_done",
+                  !state.succeeded()
+                      || error != null
+                      || (entry != null && entry.isDone() && entry.getErrorInfo() != null),
+                  captures,
+                  null);
+          emit(
+              row(
+                  "type",
+                  "event",
+                  "node_id",
+                  id,
+                  "event",
+                  "evaluated",
+                  "evaluation_state",
+                  state.name(),
+                  "new_value_supplied",
+                  value != null,
+                  "new_error_supplied",
+                  error != null,
+                  "direct_deps_supplied",
+                  directDeps != null,
+                  "dirty_type",
+                  null,
+                  "observation_id",
+                  observation == 0 ? null : observation),
+              false);
+        });
+  }
+
+  @Override
+  public synchronized void stateStarting(SkyKey key, NodeState state) {
+    long wall = clock.wall() - wallOrigin;
+    long cpu = clock.cpu();
+    boolean virtual = clock.virtual();
+    guarded(
+        () -> {
+          int id = node(key);
+          if (id == 0 || stopped) {
+            return;
+          }
+          observed.add(id);
+          ThreadState thread = threads.get(Thread.currentThread());
+          if (thread == null) {
+            if (threads.size() >= MAX_THREADS) {
+              overflow("max_threads");
+              return;
+            }
+            thread = new ThreadState(threads.size() + 1L);
+            threads.put(Thread.currentThread(), thread);
+          }
+          if (intervalSequence >= MAX_INTERVALS) {
+            overflow("max_intervals");
+            return;
+          }
+          if (thread.stack.size() >= MAX_STACK_DEPTH) {
+            overflow("max_stack_depth");
+            return;
+          }
+          String occurrenceKey = id + ":" + state.name();
+          long occurrence = occurrences.merge(occurrenceKey, 1L, Long::sum);
+          Long parent = thread.stack.isEmpty() ? null : thread.stack.peek().id;
+          thread.stack.push(
+              new Frame(++intervalSequence, parent, id, state, occurrence, wall, cpu, virtual));
+        });
+  }
+
+  @Override
+  public synchronized void stateEnding(SkyKey key, NodeState state) {
+    long wall = clock.wall() - wallOrigin;
+    long cpu = clock.cpu();
+    guarded(
+        () -> {
+          ThreadState thread = threads.get(Thread.currentThread());
+          Integer id = nodes.get(key);
+          if (thread == null
+              || thread.stack.isEmpty()
+              || id == null
+              || thread.stack.peek().node != id
+              || thread.stack.peek().state != state) {
+            unbalanced++;
+            markIncomplete("unmatched_interval_end");
+            return;
+          }
+          Frame frame = thread.stack.pop();
+          boolean clockInvalid =
+              wall < frame.wall || (cpu >= 0 && frame.cpu >= 0 && cpu < frame.cpu);
+          Long inclusive =
+              frame.cpu < 0 || cpu < 0 || frame.virtual || clockInvalid ? null : cpu - frame.cpu;
+          Long exclusive =
+              inclusive == null || frame.unknownChild ? null : inclusive - frame.childCpu;
+          if (exclusive != null && exclusive < 0) {
+            clockInvalid = true;
+            exclusive = null;
+          }
+          String status =
+              clockInvalid ? "unbalanced" : exclusive == null ? "unsupported_cpu" : "complete";
+          String reason =
+              clockInvalid
+                  ? "counter_or_child_regression"
+                  : exclusive == null ? "cpu_unavailable" : null;
+          if (clockInvalid) {
+            unbalanced++;
+            markIncomplete(reason);
+          } else if (reason != null) {
+            countUnknown(reason);
+          }
+          writeInterval(thread.id, frame, wall, cpu < 0 ? null : cpu, exclusive, status, reason);
+          if (!thread.stack.isEmpty()) {
+            if (inclusive == null || frame.unknownChild || clockInvalid) {
+              thread.stack.peek().unknownChild = true;
+            } else {
+              thread.stack.peek().childCpu += inclusive;
+            }
+          }
+        });
+  }
+
+  private void writeInterval(
+      long thread,
+      Frame frame,
+      @Nullable Long wallEnd,
+      @Nullable Long cpuEnd,
+      @Nullable Long exclusive,
+      String status,
+      @Nullable String reason) {
+    emit(
+        row(
+            "type",
+            "interval",
+            "interval_id",
+            frame.id,
+            "parent_interval_id",
+            frame.parent,
+            "node_id",
+            frame.node,
+            "thread_id",
+            thread,
+            "virtual_thread",
+            frame.virtual,
+            "state",
+            frame.state.name(),
+            "occurrence",
+            frame.occurrence,
+            "wall_start_ns",
+            frame.wall,
+            "wall_end_ns",
+            wallEnd,
+            "cpu_start_ns",
+            frame.cpu < 0 ? null : frame.cpu,
+            "cpu_end_ns",
+            cpuEnd,
+            "exclusive_cpu_ns",
+            exclusive,
+            "status",
+            status,
+            "reason",
+            reason),
+        false);
+  }
+
+  /** Exports remaining done nodes, seals the trace, and releases all retained diagnostic keys. */
+  public synchronized void finish() {
+    if (finished) {
+      return;
+    }
+    guarded(
+        () -> {
+          Map<SkyKey, Long> finalIds = new LinkedHashMap<>();
+          for (InMemoryNodeEntry entry : graph().getAllNodeEntries()) {
+            if (stopped) {
+              break;
+            }
+            if (entry.isDone() && node(entry.getKey()) != 0) {
+              long observation = reserveObservation();
+              if (observation == 0) {
+                break;
+              }
+              finalIds.put(entry.getKey(), observation);
+            }
+          }
+          for (Map.Entry<SkyKey, Long> item : finalIds.entrySet()) {
+            if (stopped) {
+              break;
+            }
+            InMemoryNodeEntry entry = graph().getIfPresent(item.getKey());
+            boolean done = entry != null && entry.isDone();
+            observe(
+                item.getKey(),
+                done ? entry.getValue() : null,
+                deps(entry),
+                "retained_done",
+                "retained_done",
+                done && entry.getErrorInfo() != null,
+                finalIds,
+                item.getValue());
+          }
+          for (ThreadState thread : threads.values()) {
+            while (!thread.stack.isEmpty()) {
+              Frame frame = thread.stack.pop();
+              unbalanced++;
+              markIncomplete("unclosed_interval");
+              writeInterval(thread.id, frame, null, null, null, "unbalanced", "unclosed_interval");
+            }
+          }
+        });
+    int retainedOnly = 0;
+    for (int id : retained) {
+      if (!observed.contains(id)) {
+        retainedOnly++;
+      }
+    }
+    Map<String, Object> footer =
+        row(
+            "type",
+            "footer",
+            "record_counts",
+            new LinkedHashMap<>(counts),
+            "node_count",
+            nodes.size(),
+            "edge_count",
+            edgeCount,
+            "observed_node_count",
+            observed.size(),
+            "retained_only_node_count",
+            retainedOnly,
+            "dependency_only_node_count",
+            nodes.size() - observed.size() - retainedOnly,
+            "unknown_counts",
+            new LinkedHashMap<>(unknown),
+            "limits_exceeded",
+            new ArrayList<>(exceeded),
+            "unbalanced_intervals",
+            unbalanced,
+            "writer_error",
+            writerError,
+            "preceding_bytes_sha256",
+            HexFormat.of().formatHex(digest.digest()),
+            "complete",
+            complete && !stopped);
+    try {
+      writer.flush();
+    } catch (IOException e) {
+      complete = false;
+      writerError = e.getClass().getSimpleName();
+    }
+    footer.put("complete", complete && !stopped && writerError == null);
+    footer.put("writer_error", writerError);
+    emit(footer, true);
+    try {
+      writer.flush();
+    } catch (IOException e) {
+      complete = false;
+      writerError = e.getClass().getSimpleName();
+    }
+    try {
+      writer.close();
+    } catch (IOException e) {
+      complete = false;
+      writerError = e.getClass().getSimpleName();
+    }
+    finished = true;
+    nodes.clear();
+    observed.clear();
+    retained.clear();
+    threads.clear();
+    occurrences.clear();
+  }
+
+  /** Final I/O status; the module must invalidate the output on a late flush/close failure. */
+  public synchronized boolean isComplete() {
+    return finished && complete && !stopped && writerError == null;
+  }
+
+  @Override
+  public void close() {
+    finish();
+  }
+}
