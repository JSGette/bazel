+  private static Map<String, Object> context(String workspace) {
+    Map<String, Object> header = new LinkedHashMap<>();
+    header.put("engine_id", "engine-0");
+    header.put("cohort_id", "module-fixture");
+    header.put("phase", "fixture");
+    header.put("hosting", "private");
+    header.put("binary_sha256", "a".repeat(64));
+    header.put(
+        "source_identity",
+        Map.of(
+            "base_commit",
+            "b".repeat(40),
+            "patch_sha256",
+            "c".repeat(64),
+            "reconstructed_git_tree",
+            "d".repeat(40)));
+    header.put("semantic_epoch", "module-fixture-v1");
+    header.put("snapshot_id", "e".repeat(64));
+    header.put("command_policy_sha256", "f".repeat(64));
+    header.put(
+        "repository_bindings",
+        Map.of(
+            "main",
+            Map.of(
+                "logical_repository_id",
+                "module-fixture-main",
+                "physical_root",
+                workspace,
+                "filesystem_policy",
+                Map.of("os", "linux", "case_sensitive", true, "digest_algorithm", "SHA-256"),
+                "binding_provenance_sha256",
+                "0".repeat(64))));
+    header.put("bzl_inlining", "unknown");
+    return header;
+  }
+
+  private Path contextFile(String workspace) throws IOException {
+    Path path = path("context.json");
