+    assertThrows(SerializationException.class, () -> encode(codecs, nested));
+  }
+
+  @Test
+  public void importedUnsafeProviderCannotBeRestoredOrRepublished() throws Exception {
+    // Simulate a publication that bypassed producer admission. The consumer repeats the check
+    // after every field has been decoded, before exposing the provider to local analysis.
+    var bytes = encode(codecs(new UncheckedCodec()), unsafeProvider());
+    assertThrows(SerializationException.class, () -> decode(bytes));
+    var imported =
+        StarlarkInfo.create(StructProvider.STRUCT, ImmutableMap.of("imported", unsafeProvider()));
+    assertThrows(SerializationException.class, () -> encode(codecs, imported));
+  }
+
+  private static final class UncheckedCodec extends DeferredObjectCodec<StarlarkInfo> {
+    private final LocalStarlarkInfoCodec guarded = new LocalStarlarkInfoCodec();
+
+    @Override
+    public Class<? extends StarlarkInfo> getEncodedClass() {
+      return guarded.getEncodedClass();
+    }
+
+    @Override
+    public ImmutableSet<Class<? extends StarlarkInfo>> additionalEncodedClasses() {
+      return guarded.additionalEncodedClasses();
+    }
+
+    @Override
+    public boolean autoRegister() {
+      return false;
+    }
+
+    @Override
+    public void serialize(SerializationContext context, StarlarkInfo value, CodedOutputStream out)
+        throws SerializationException, IOException {
+      out.writeFixed32NoTag(0x53504931);
+      out.writeStringNoTag(value.getClass().getName());
+      for (var field : DynamicCodec.getFieldHandlerMap(value.getClass()).values()) {
+        field.serialize(context, out, value);
+      }
+    }
+
+    @Override
+    public DeferredValue<? extends StarlarkInfo> deserializeDeferred(
+        AsyncDeserializationContext context, CodedInputStream in) {
+      throw new UnsupportedOperationException();
+    }
+  }
