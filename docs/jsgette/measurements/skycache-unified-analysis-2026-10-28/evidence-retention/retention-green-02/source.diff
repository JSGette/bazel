+  private static PendingMemoProbe startMemoRetentionProbe() throws Exception {
+    var store = new GetRecordingStore();
+    var service =
+        new FingerprintValueService(
+            safeDirectExecutor(),
+            store,
+            new FingerprintValueCache(FingerprintValueCache.SyncMode.NOT_LINKED),
